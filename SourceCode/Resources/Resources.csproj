<Project Sdk="Microsoft.NET.Sdk">
  <!--
    All translations of the app, in one set: Strings.resx (English, the neutral language) and Strings.<lang>.resx.
    Used by Data, Services and App, both through IStringLocalizer<Strings> and the generated class ModulesRegistry.Resources.Strings.
    The class is generated by MSBuild at build time (no Designer.cs to keep in sync); keys that aren't valid C# names
    (for example "In the morning") are only reachable by name, through the localizer or AppTexts.
  -->
  <PropertyGroup>
    <AssemblyName>ModulesRegistry.Resources</AssemblyName>
    <RootNamespace>ModulesRegistry.Resources</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tellurian.Localization" Version="1.7.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ModulesRegistry.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>