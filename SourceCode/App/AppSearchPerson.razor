@using System.Linq.Expressions
@inject IStringLocalizer<App> Localizer
@inject PersonService PersonService

@*
    Search for a person by name, bound with @bind-Value to a person id.
    The only component that uses Blazored.Typeahead, so it can be replaced in one place (Migration.md step 1.3).
*@

<div class="col-md-4">
    <label class="form-control-label" for="personid">@SearchLabel</label>
    <BlazoredTypeahead TItem="ListboxItem" TValue="int" SearchMethod="SearchPersons" Value="Value" ValueChanged="OnValueChanged" ValueExpression="ValueExpression" ConvertMethod="ConvertPerson" MinimumLength="MinimumSearchCharacters" MaximumSuggestions="10" EnableDropDown="true" Class="form-select">
        <SelectedTemplate Context="personId">
            @{
                var selectedPerson = SelectedPerson(personId);
                <text>@selectedPerson?.Description</text>
            }
        </SelectedTemplate>
        <ResultTemplate Context="person">
            @person.Description
        </ResultTemplate>
        <NotFoundTemplate Context="NotFound">
            <div>
                <span>
                    @Localizer["NotFound"]
                    @if (AddPersonHref is not null)
                    {
                        <a class="btn btn-link" href="@AddPersonHref">@Localizer["Add"]</a>
                    }
                </span>
            </div>
        </NotFoundTemplate>
    </BlazoredTypeahead>
    @if (ValidationFor is not null)
    {
        <ValidationMessage For="ValidationFor" />
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public Expression<Func<int>>? ValueExpression { get; set; }

    [Parameter] public string? SearchLabel { get; set; }
    [Parameter] public int MinimumSearchCharacters { get; set; } = 3;
    /// <summary>Country to search persons in; 0 means the current user's country. Persons are reloaded when it changes.</summary>
    [Parameter] public int CountryId { get; set; }
    /// <summary>Persons that are already members of this group are not listed.</summary>
    [Parameter] public int? ExcludeGroupId { get; set; }
    /// <summary>Link shown with "Add" when no person matches.</summary>
    [Parameter] public string? AddPersonHref { get; set; }
    /// <summary>Validation message shown below the search, for example for the entity's person property.</summary>
    [Parameter] public Expression<Func<object?>>? ValidationFor { get; set; }

    private ClaimsPrincipal? Principal;
    private IEnumerable<ListboxItem>? Persons;
    private (int CountryId, int ExcludeGroupId)? LoadedFor;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var countryId = CountryId == 0 ? Principal.CountryId() : CountryId;
        var excludeGroupId = ExcludeGroupId ?? 0;
        if (LoadedFor == (countryId, excludeGroupId)) return;
        LoadedFor = (countryId, excludeGroupId);
        Persons = await PersonService.ListboxItemsAsync(Principal, countryId, excludeGroupId);
    }

    private Task OnValueChanged(int personId)
    {
        Value = personId;
        return ValueChanged.InvokeAsync(personId);
    }

    private Task<IEnumerable<ListboxItem>> SearchPersons(string searchText) =>
        Task.FromResult<IEnumerable<ListboxItem>>(Persons is null ? [] :
            Persons.Where(p => !p.IsHidden && p.Description.ToLowerInvariant().Contains(searchText.ToLowerInvariant())).ToList());

    private ListboxItem? SelectedPerson(int? id) => id is null ? null : Persons?.FirstOrDefault(p => p.Id == id.Value);

    private static int ConvertPerson(ListboxItem person) => person.Id;
}