@page "/Meetings/{id:int}/Layouts/Edit"

@attribute [Authorize(Policy = "User")]
@attribute [ExcludeFromInteractiveRouting]
@* Static SSR (Migration step 3.6): a meeting's layouts, with Add, Edit and the layout's pages for its organisers. Delete is a link
   that adds ?delete={layout id}, which shows a confirmation with a POST form; MeetingService deletes only for meeting organisers. *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject MeetingService MeetingService

<PageHeading Label="Layouts" Context="@Meeting" IconClass="Layout" BackHref="@($"Meetings/{Id}/Edit")" />
@if (Meeting is not null)
{
    @if (LayoutToDelete is not null)
    {
        <div class="alert alert-warning mt-2" role="alert">
            <form method="post" @formname="delete-layout" @onsubmit="DeleteLayoutAsync" data-enhance>
                <AntiforgeryToken />
                <input type="hidden" name="DeleteLayoutId" value="@LayoutToDelete.Id" />
                <strong>@Localizer["Delete"] @LayoutToDelete.DescriptionWithName()?</strong>
                <AppButton Label="Delete" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
                <AppButton Label="Cancel" Href="@SelfHref" AlwaysShowLabel="true" />
            </form>
        </div>
    }
    @if (MayEdit)
    {
        <div>
            <AppButton Label="Add" Href="@LayoutHref(0)" />
        </div>
    }
    <TableTemplate Items="Meeting.Layouts" HideNoRecordsToDisplay="true">
        <TableHeader>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["ResponsibleGroup"]</th>
            <th>@Localizer["OperatingPeriod"]</th>
            <th>@Localizer["IsRegistrationPermitted"]</th>
            <th>@Localizer["Actions"]</th>
        </TableHeader>
        <RowTemplate Context="meetingLayout">
            <td>@meetingLayout.DescriptionWithName()</td>
            <td>@meetingLayout.OrganisingGroup.FullName</td>
            <td>@OperatingPeriod(meetingLayout)</td>
            <td>@meetingLayout.IsRegistrationPermitted.AsYesOrNo()</td>
            <td>
                @if (MayEdit)
                {
                    <AppButton Label="Edit" Href="@LayoutHref(meetingLayout.Id)" />
                    @if (meetingLayout.IsRegistrationPermitted)
                    {
                        <AppButton Label="Modules" Title="RegisteredModules" Href="@($"Layouts/{meetingLayout.Id}/Modules")" />
                        <AppButton Label="Waybills" Title="InternalWaybills" Href="@($"Reports/Waybills/Layout/{meetingLayout.Id}")" />
                        <AppButton Label="Tickets" Title="Tickets" Href="@($"Reports/Tickets/Layout/{meetingLayout.Id}")" IconName="@FontAwesome.Ticket" />
                        <AppButton Label="Delete" Href="@($"{SelfHref}?delete={meetingLayout.Id}")" />
                    }
                }
            </td>
        </RowTemplate>
    </TableTemplate>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "delete")] private int? DeleteId { get; set; }
    [SupplyParameterFromForm(FormName = "delete-layout")] private int DeleteLayoutId { get; set; }

    ClaimsPrincipal? Principal;
    Meeting? Meeting;
    bool MayEdit;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Meeting = Id > 0 ? await MeetingService.FindByIdAsync(Id) : null;
        if (Meeting is not null) MayEdit = await MeetingService.IsAdministratorOrMeetingOrganiser(Principal, Meeting.Id);
    }

    Layout? LayoutToDelete => MayEdit && DeleteId > 0 ? Meeting?.Layouts.FirstOrDefault(l => l.Id == DeleteId) : null;
    string SelfHref => $"Meetings/{Id}/Layouts/Edit";
    string LayoutHref(int id) => $"Meetings/{Id}/Layouts/{id}";
    static string OperatingPeriod(Layout layout) => layout.FirstYear.HasValue && layout.LastYear.HasValue ? $"{layout.FirstYear}-{layout.LastYear}" : string.Empty;

    async Task DeleteLayoutAsync()
    {
        if (Meeting is null || !Meeting.Layouts.Any(l => l.Id == DeleteLayoutId)) return;
        var deleted = (await MeetingService.DeleteLayoutAsync(Principal, Meeting.Id, DeleteLayoutId)).Count > 0;
        HttpContext.SetFlashMessage(deleted ? "DeletedSuccessfully" : "DeleteFailed", deleted);
        Navigator.NavigateTo(SelfHref);
    }
}