@page "/Meetings/{MeetingId:int}/Register"
@page "/Meetings/{MeetingId:int}/Edit/{PersonId:int}"

@* Static SSR (Migration step 3.6): registering for a meeting. Not signed in, the page tells how to attend. Those who manage the
   meeting's participants choose a person with a GET form (country and person search, ?country= and ?person=, which opens
   /Meetings/{id}/Edit/{person}) and see the participants, with Edit links and Unregister / Register again as POST buttons. Others
   see their own registration. The days and times are posted as MeetingParticipantFormData (the days between the first and last
   checked day are filled in when saved); leaving a layout is a POST button, joining one is on the module registration page.
   MeetingService and LayoutParticipantService decide what is allowed. After each POST, a redirect to this page; the result is a
   one-time message. *@

@using ModulesRegistry.Forms.Meetings

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject ITimeProvider TimeProvider
@inject MeetingService MeetingService
@inject LayoutParticipantService LayoutParticipantService
@inject CountryService CountryService

<PageHeading Label="Registration" Context="Meeting" IconClass="@FontAwesome.Register" PageAction="PageAction.Unknown" HelpContext="RegisterParticipant" BackHref="@BackHref" />

@if (Meeting is null)
{
    <ActionMessage Label="NoRecordsToDisplay" AlertType="warning" />
}
else if (Meeting.IsNotPermittingRegistrations())
{
    <ActionMessage AlertType="Warning" Label="MeetingDoesAcceptRegistrations" />
}
else if (Meeting.IsNotYetOpenForRegistration(TimeProvider.LocalTime))
{
    <ActionMessage AlertType="Warning" Label="@MeetingOpensForRegistration(Meeting)" />
}
else
{
    <PrincipalContentView Principal="Principal" NotAuthenticatedContent="AttendToMeeting">
        <h4>@Meeting.ParticipationSummary()</h4>
        <hr />
        @if (FailureMessage is not null)
        {
            <ActionMessage Label="@FailureMessage" AlertType="stop" />
        }
        @if (MayManageParticipants)
        {
            <div class="noprint">
                <h3>@Localizer["SelectPersonToRegister"]</h3>
                <ListboxForm Id="register-country" Action="@RegisterHref" Name="country" Items="CountryItems" ItemType="Country" SelectedId="CountryId" />
                <form method="get" action="@RegisterHref" class="row g-3 align-items-end" data-enhance>
                    <input type="hidden" name="country" value="@CountryId" />
                    <AppSearchPerson Name="person" SearchLabel="@Localizer.SearchObject("Person", MinimumSearchCharacters)"
                                     MinimumSearchCharacters="MinimumSearchCharacters" CountryId="CountryId" MeetingId="Meeting.Id" />
                    <div class="col-md-2"><AppButton Label="Select" IsSubmit="true" AlwaysShowLabel="true" /></div>
                </form>
                <hr />
            </div>
        }

        @if (MayManageParticipants && Participant is null)
        {
            <div style="padding: 10px 0px">
                <MailToButton Recipients="Meeting.ParticipantsMails()" Sender="Principal!.Sender()" Subject="@Meeting.Name" />
                <MailCopyButton Recipients="Meeting.ParticipantsMails()" />
                @foreach (var layout in Meeting.Layouts.Where(l => l.IsRegistrationPermitted))
                {
                    <AppButton Href="@($"Layouts/{layout.Id}/Modules")" ObjectName="@(layout.DescriptionWithName())" Label="Participants" IconName="@FontAwesome.Layout" />
                }
            </div>

            <form id="participant-actions" method="post" @formname="participant-actions" @onsubmit="ParticipantActionAsync" data-enhance>
                <AntiforgeryToken />
            </form>
            <TableTemplate Items="Meeting.Participants.OrderBy(p => p.Person.FirstName).ThenBy(p => p.Person.LastName)">
                <TableHeader>
                    <th>@Localizer["Participant"]</th>
                    @if (Meeting.IsFremo())
                    {
                        <th>@Localizer["Member"]</th>
                    }
                    <th>@Localizer["City"]</th>
                    @if (HasParticipantsFromSeveralCountries)
                    {
                        <th>@Localizer["Country"]</th>
                    }
                    <th>@Localizer["Registered"]</th>
                    <th>@Localizer["Participates"]</th>
                    <th>@Localizer["Layouts"]</th>
                    <th class="noprint">@Localizer["Actions"]</th>
                </TableHeader>
                <RowTemplate Context="item">
                    <td style="@ParticipantStatusStyle(item)">@item.Person.Name() @item.Person.EmailIcon() @item.ApprovedIcon()</td>
                    @if (Meeting.IsFremo())
                    {
                        <td>@item.Person.FremoNumber()</td>
                    }
                    <td>@item.Person.CityName</td>
                    @if (HasParticipantsFromSeveralCountries)
                    {
                        <td><img src="@item.Person.Country.FlagSrc()"> @item.Person.Country.EnglishName.AsLocalized()</td>
                    }
                    <td>@item.RegistrationTime.ToString("g")</td>
                    <td>@item.Participates(Localizer)</td>
                    <td>@item.ParticipatesInLayouts(Localizer)</td>
                    <td class="noprint" style="white-space: nowrap;">
                        <AppButton Label="Edit" Href="@EditHref(item.PersonId)" />
                        @if (item.CancellationTime.HasValue)
                        {
                            <AppButton Label="Register" IsSubmit="true" Form="participant-actions" Name="ReRegisterParticipantId" Value="@item.Id.ToString()" IconName="@FontAwesome.Register" />
                        }
                        else
                        {
                            <AppButton Label="Unregister" IsSubmit="true" Form="participant-actions" Name="CancelParticipantId" Value="@item.Id.ToString()" IconName="@FontAwesome.Unregister" />
                        }
                    </td>
                </RowTemplate>
            </TableTemplate>
        }

        @if (Participant?.Id > 0)
        {
            <h4>@Localizer["Registered"]</h4>
            @if (Participant.CancellationTime.HasValue)
            {
                <p style="color: red; font-weight: bold">@Localizer["ParticipantCanceled"] @Participant.CancellationTime.Value.ToString("g")</p>
            }
            <ul>
                <li>@Localizer["Name"]: <strong>@Participant.Person.Name()</strong></li>
                <li>@Localizer["RegistrationTime"]: <strong>@Participant.RegistrationTime.ToString("g")</strong></li>
                <li>@Localizer["Participates"]: <strong>@Participant.Participates(Localizer)</strong> </li>
            </ul>
        }

        @if (Participant is not null && !Meeting.IsFullyRegistered())
        {
            <EditTemplate Item="Form" FormName="participant" OnValidSubmit="SaveAsync" ShowSaveButton="MayEdit">
                <Inputs>
                    <h3>@Localizer["Days"]</h3>
                    <AppCheckGroup>
                        @if (Meeting.DaysCount() > 0) { <AppInputCheck @bind-Value="Form!.Day1" Label="@Meeting.Day(1).AsLocalized()" /> }
                        @if (Meeting.DaysCount() > 1) { <AppInputCheck @bind-Value="Form!.Day2" Label="@Meeting.Day(2).AsLocalized()" /> }
                        @if (Meeting.DaysCount() > 2) { <AppInputCheck @bind-Value="Form!.Day3" Label="@Meeting.Day(3).AsLocalized()" /> }
                        @if (Meeting.DaysCount() > 3) { <AppInputCheck @bind-Value="Form!.Day4" Label="@Meeting.Day(4).AsLocalized()" /> }
                        @if (Meeting.DaysCount() > 4) { <AppInputCheck @bind-Value="Form!.Day5" Label="@Meeting.Day(5).AsLocalized()" /> }
                        @if (Meeting.DaysCount() > 5) { <AppInputCheck @bind-Value="Form!.Day6" Label="@Meeting.Day(6).AsLocalized()" /> }
                    </AppCheckGroup>
                    <ValidationMessage For="() => Form!.Day1" />
                    <AppFormRow>
                        <AppInputTimeOnly Width="2" @bind-Value="Form!.LatestArrivalTime" Label="@LatestArrivalTimeLabel" />
                        <AppInputTimeOnly Width="2" @bind-Value="Form!.EarliestDepartureTime" Label="@EarliestDepartureTimeLabel" />
                    </AppFormRow>
                </Inputs>
            </EditTemplate>
        }

        @if (Participant?.Id > 0 && (MayManageParticipants || Meeting.PermitsRegistrations()))
        {
            <h4>@Localizer["SelectOrModifyLayoutParticipation"]</h4>
            <form id="layout-actions" method="post" @formname="layout-actions" @onsubmit="LeaveLayoutAsync" data-enhance>
                <AntiforgeryToken />
            </form>
            <TableTemplate Items="@LayoutParticipations">
                <TableHeader>
                    <th width="15%">@Localizer["Layout"]</th>
                    <th>@Localizer["Organiser"]</th>
                    <th>@Localizer["Note"]</th>
                    <th width="400px">@Localizer["Actions"]</th>
                </TableHeader>
                <RowTemplate Context="item">
                    <td>@item.Layout.DescriptionWithName()</td>
                    <td>@item.Layout.OrganisingGroup?.FullName</td>
                    <td>
                        @if (item.Layout.IsClosedForRegistration(TimeProvider.LocalTime) || item.Layout.IsFullyRegistered())
                        {
                            <span style="color:red;">@Localizer["RegistrationClosed"]</span>
                        }
                    </td>
                    <td>
                        @if (MayManageParticipants || (item.Layout.IsOpenForRegistration(TimeProvider.LocalTime) && !item.Layout.IsFullyRegistered()))
                        {
                            <AppButton IconName="@(item.IsParticipating ? FontAwesome.Edit : FontAwesome.Register)" Label="@(item.IsParticipating ? "Edit" : "Participate")" Href="@RegisterModulesHref(item)" />
                            @if (item.LayoutParticipant is { } layoutParticipant)
                            {
                                <AppButton Label="Unregister" IconName="@FontAwesome.Cancel" Type="Danger" IsSubmit="true" Form="layout-actions" Name="LeaveLayoutParticipantId" Value="@layoutParticipant.Id.ToString()" />
                            }
                        }
                        @if (item.LayoutParticipant?.LayoutStations.Any() == true)
                        {
                            <AppButton Label="InternalWaybills" IconName="@FontAwesome.Waybills" Href="@($"Layouts/{item.Layout.Id}/Waybills/{item.Participant.PersonId}")" />
                        }
                    </td>
                </RowTemplate>
            </TableTemplate>
        }
    </PrincipalContentView>
}

@code {
    // The meetings list is static, so this page may have no history (Migration step 3.3).
    const string BackHref = "Meetings/Index";
    const int MinimumSearchCharacters = 3;
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int MeetingId { get; set; }
    [Parameter] public int PersonId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] private int? SelectedCountryId { get; set; }
    [SupplyParameterFromQuery(Name = "person")] private int? SelectedPersonId { get; set; }
    [SupplyParameterFromForm(FormName = "participant")] private MeetingParticipantFormData? Form { get; set; }
    [SupplyParameterFromForm(FormName = "participant-actions")] private int CancelParticipantId { get; set; }
    [SupplyParameterFromForm(FormName = "participant-actions")] private int ReRegisterParticipantId { get; set; }
    [SupplyParameterFromForm(FormName = "layout-actions")] private int LeaveLayoutParticipantId { get; set; }

    ClaimsPrincipal? Principal;
    Meeting? Meeting;
    MeetingParticipant? Participant;
    IEnumerable<ListboxItem>? CountryItems;
    IEnumerable<LayoutParticipation> LayoutParticipations = [];
    int CountryId;
    bool MayManageParticipants;
    bool HasParticipantsFromSeveralCountries;
    string? FailureMessage;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Meeting = MeetingId > 0 ? await MeetingService.FindByIdAsync(MeetingId) : null;
        if (Meeting is null || !Principal.IsAuthenticated()) return;
        HasParticipantsFromSeveralCountries = Meeting.HasParticipantsFromSeveralCountries();
        // Global administrators, country administrators in the arranging group's country, and the meeting administrators of the
        // arranging group or of a layout's group register participants from any country.
        MayManageParticipants = await MeetingService.MayManageMeetingParticipants(Principal, Meeting.Id);
        if (SelectedPersonId > 0 && PersonId == 0 && MayManageParticipants)
        {
            Navigator.NavigateTo(EditHref(SelectedPersonId.Value)); // The chosen person's registration has its own address.
            return;
        }
        if (MayManageParticipants)
        {
            CountryItems = await CountryService.ListboxItemsAsync(Principal, true);
            CountryId = SelectedCountryId ?? Principal.CountryId();
        }
        var personId = PersonId > 0 && (MayManageParticipants || PersonId == Principal.PersonId()) ? PersonId : MayManageParticipants ? 0 : Principal.PersonId();
        if (personId > 0)
        {
            Participant = await MeetingService.FindParticipantAsync(Principal, MeetingId, personId) ?? Meeting.DefaultParticipant(personId);
            LayoutParticipations = Participant.Id > 0 ? Meeting.Layouts.Where(l => l.IsRegistrationPermitted).Select(l => new LayoutParticipation(l, Participant)).ToList() : [];
            // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
            Form ??= Participant.AsFormData();
        }
        else
        {
            Form = null;
        }
    }

    bool MayEdit => Meeting?.Id > 0 && Participant is not null && (
        MayManageParticipants ||
        (!Participant.CancellationTime.HasValue && Participant.PersonId == Principal.PersonId() && Meeting.IsOpenForRegistration(TimeProvider.LocalTime)));

    string RegisterHref => $"Meetings/{MeetingId}/Register";
    string EditHref(int personId) => $"Meetings/{MeetingId}/Edit/{personId}";
    string SelfHref => PersonId > 0 ? EditHref(PersonId) : RegisterHref;
    string RegisterModulesHref(LayoutParticipation it) => $"MeetingParticipants/{it.Participant.Id}/Layouts/{it.Layout.Id}/RegisterModules";

    async Task SaveAsync()
    {
        if (Form is null || Participant is null || !MayEdit) return;
        // Only the days and times change on the loaded registration; saving also registers again a cancelled one.
        var participant = Form.AsEntity(Participant);
        participant.CancellationTime = null;
        var (count, message, _) = await MeetingService.SaveAsync(Principal, participant);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo(SelfHref);
    }

    async Task ParticipantActionAsync()
    {
        if (Meeting is null || !MayManageParticipants) return;
        (int Count, string? Message) result = (0, null);
        if (CancelParticipantId > 0 && Meeting.Participants.Any(p => p.Id == CancelParticipantId))
            result = await MeetingService.CancelMeetingParticipaction(Principal, CancelParticipantId);
        else if (ReRegisterParticipantId > 0 && Meeting.Participants.Any(p => p.Id == ReRegisterParticipantId))
        {
            var (count, message, _) = await MeetingService.ReRegisterMeetingParticipaction(Principal, ReRegisterParticipantId);
            result = (count, message);
        }
        if (result.Count <= 0)
        {
            FailureMessage = result.Message ?? "SaveFailed"; // A service message is a text, not a key: shown here, not after a redirect.
            return;
        }
        HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        Navigator.NavigateTo(SelfHref);
    }

    async Task LeaveLayoutAsync()
    {
        // Only a layout registration of this participant (the service also checks the rights).
        if (Participant is null || !Participant.LayoutParticipations.Any(lp => lp.Id == LeaveLayoutParticipantId)) return;
        var (count, message) = await LayoutParticipantService.DeleteAsync(Principal, LeaveLayoutParticipantId);
        if (count <= 0)
        {
            FailureMessage = message ?? "DeleteFailed";
            return;
        }
        HttpContext.SetFlashMessage("DeletedSuccessfully", FlashMessageLevel.Success);
        Navigator.NavigateTo(SelfHref);
    }

    string ParticipantStatusStyle(MeetingParticipant? it) => it is null ? string.Empty : it.CancellationTime.HasValue ? "color: red; text-decoration: line-through;" : string.Empty;

    // The labels name the first and last checked day of the stored registration.
    string LatestArrivalTimeLabel => WithDay(Localizer["LatestArrivalTime"], Participant?.FirstParticipationDayNumber() ?? 0);
    string EarliestDepartureTimeLabel => WithDay(Localizer["EarliestDepartureTime"], Participant?.LastParticipationDayNumber() ?? 0);
    string WithDay(string label, int day) => Meeting is null || day == 0 ? label : $"{label} {DayInText(Meeting.Day(day).AsLocalized())}";

    // Day names are written in lower case in running text in Swedish, Danish and Norwegian, but capitalised in English and German.
    static string DayInText(string dayName) =>
        LanguageExtensions.CurrentCulture.TwoLetterISOLanguageName is "sv" or "da" or "nb" ? dayName.ToLower(LanguageExtensions.CurrentCulture) : dayName;

    string MeetingOpensForRegistration(Meeting it) => string.Format(Localizer["MeetingOpensForRegistrationAtDate"], it.RegistrationOpensDate());
}