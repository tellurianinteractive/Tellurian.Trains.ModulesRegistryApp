@page "/TermsOfUse"

@inject NavigationManager Navigator
@inject IStringLocalizer<Strings> Localizer
@inject UserService UserService

@* Static SSR (Migration step 3.2b). Accepting is a form posted to this page, so it works without JavaScript. The claims
   are built per request (ApplicationClaimsTransformation), so the redirect after the post already sees the acceptance. *@

<h1><span class="fa fa-file-signature" />@Localizer["TermsOfUse"]</h1>
@if (MustAccept)
{
    <ActionMessage AlertType="warning" Label="PleaseReadAndAccept" />
}
<ContentView ContentName="TermsOfUse" ShowModificationTime="true" />
@if (MustAccept)
{
    <form method="post" @formname="accept-terms-of-use" @onsubmit="OnAccept">
        <AntiforgeryToken />
        <AppButton Label="Accept" IconName="@FontAwesome.Signature" IsSubmit="true" AlwaysShowLabel="true" />
    </form>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private ClaimsPrincipal? Principal;

    private bool MustAccept => Principal.IsAuthenticated() && !Principal.IsLatestTermsOfUseAccepted();

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
    }

    private async Task OnAccept()
    {
        if (!MustAccept) return;
        var result = await UserService.AcceptTermsOfUse(Principal.ObjectId());
        if (result is not null)
        {
            Navigator.NavigateTo("/");
        }
    }
}