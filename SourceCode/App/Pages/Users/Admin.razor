@page "/admin/users"
@page "/admin/users/country/{CountryId:int}"
@using System.Globalization
@using System.Net.Mail

@attribute [Authorize(Policy = "Admin")]
@attribute [ExcludeFromInteractiveRouting]
@* Static SSR (Migration step 3.3), as the persons list: the country is chosen with a GET form to /admin/users?country=...,
   which redirects to the country's address; the date for users not signed in is a GET form (?since=yyyy-MM-dd). The test
   mail is a POST form (antiforgery), followed by a redirect with the result as a one-time message (SetFlashMessage). *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject CountryService CountryService
@inject UserService UserService
@inject PersonService PersonService
@inject AppService AppService
@inject IMailSender MailSender
@inject ITimeProvider TimeProvider

<PageHeading Label="UserAdministration" IconClass="@FontAwesome.User" PageAction="@PageAction.Tools" />

<ListboxForm Id="users-country" Action="admin/users" Name="country" Items="CountryListItems" ItemType="Country" SelectedId="CountryId" />

@if (Principal is not null && CurrentCountry is not null)
{
    @if (PeopleWithUserAccount.Any())
    {
        <div style="padding: 5px 0px;">
            <h3>@(string.Format(Localizer["SendMailToAllUsersIn"], CountryName))</h3>
            <MailGroupButtons People="PeopleWithUserAccount" Sender="Principal.MailHolder()" Subject="@MailSubject" />
        </div>
    }
    @if (PeopleWithEmail.Any())
    {
        <div style="padding: 5px 0px;">
            <h3>@(string.Format(Localizer["SendMailToAllWithEmailIn"], CountryName))</h3>
            <MailGroupButtons People="PeopleWithEmail" Sender="Principal.MailHolder()" Subject="@MailSubject" />
        </div>
    }
    @if (Administrators.Any())
    {
        <div style="padding: 5px 0px;">
            <h3>@Localizer["SendMailToAdministrators"]</h3>
            <MailGroupButtons People="Administrators" Sender="Principal.MailHolder()" Subject="@MailSubject" />
        </div>
    }
    <div style="padding: 5px 0px;">
        <h3>@(string.Format(Localizer["SendMailToUsersNotSignedInSinceIn"], CountryName))</h3>
        <form id="users-since" method="get" data-auto-submit data-enhance class="noprint" style="display: flex; align-items: center; gap: 10px; padding-bottom: 5px;">
            <label for="notSignedInSince">@Localizer["NotSignedInSince"]</label>
            <input id="notSignedInSince" name="since" type="date" class="form-control" style="width: auto;" value="@NotSignedInSinceDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <button type="submit" class="visually-hidden">@Localizer["Filter"]</button>
        </form>
        <MailGroupButtons People="PeopleNotSignedInSince" Sender="Principal.MailHolder()" Subject="@MailSubject" />
    </div>
    @if (PeopleWithoutMail.Any())
    {
        <h3>@(string.Format(Localizer["PeopleWithoutEmailAddressIn"], CountryName))</h3>
        <div>
            @string.Join(", ", PeopleWithoutMail.Select(p => p.Name()))
        </div>
    }
}
<div style="padding: 5px 0px;">
    <h3>@Localizer["SendTestMail"]</h3>
    <form id="users-testmail" method="post" @formname="testmail" @onsubmit="SendTestMailAsync" data-enhance>
        <AntiforgeryToken />
        <AppButton Label="Send" IsSubmit="true" IconName="@FontAwesome.Mail" AlwaysShowLabel=true />
    </form>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CountryId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public int? SelectedCountryId { get; set; }
    [SupplyParameterFromQuery(Name = "since")] public string? Since { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ClaimsPrincipal? Principal;
    private IEnumerable<ListboxItem>? CountryListItems;
    private IEnumerable<Person> People = [];
    private IEnumerable<Person> PeopleWithEmail = [];
    private IEnumerable<Person> PeopleWithoutMail = [];
    private IEnumerable<Person> PeopleWithUserAccount = [];
    private IEnumerable<Person> PeopleNotSignedInSince = [];
    private Country? CurrentCountry;
    private IEnumerable<Person> Administrators = [];
    private DateOnly NotSignedInSinceDate;

    private string CountryName => LanguageExtensions.GetLocalizedString(CurrentCountry?.EnglishName);
    private string MailSubject => LanguageExtensions.GetLocalizedString("ModuleRegistry", Language);
    private string Language => CurrentCountry is null ? "en" : CurrentCountry.Languages.ToItems().First();

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        CountryListItems = await CountryService.ListboxItemsAsync(Principal);
        Administrators = [.. (await UserService.GetCountryAdministratorsAsync()).AdministratorsFor(Principal)];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CountryId < 1)
        {
            var id = SelectedCountryId > 0 ? SelectedCountryId.Value : Principal.CountryId();
            Navigator.NavigateTo($"admin/users/country/{id}");
            return;
        }
        NotSignedInSinceDate = DateOnly.TryParseExact(Since, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var since) ? since : TimeProvider.Today.AddYears(-1);
        CurrentCountry = await CountryService.FindById(CountryId);
        if (CurrentCountry is null) return;
        AppService.LastCountryId = CountryId;
        People = await PersonService.GetAllInCountryAsync(Principal, CountryId);
        PeopleWithEmail = [.. People.Where(p => p.EmailAddresses.HasValue)];
        PeopleWithoutMail = [.. People.Where(p => p.EmailAddresses.IsEmpty)];
        PeopleWithUserAccount = [.. People.Where(p => p.IsActiveUser())];
        PeopleNotSignedInSince = [.. People.NotSignedInSince(new DateTimeOffset(NotSignedInSinceDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero))];
    }

    private async Task SendTestMailAsync()
    {
        var message = new MailMessage(new MailAddress("moduleregistry@tellurian.se", Localizer["AppName"]), new MailAddress(Principal!.EmailAddress(), Principal!.GivenName()))
        {
            Subject = "Test",
            Body = "This is a test message.",
            Sender = new MailAddress("moduleregistry@tellurian.se", Localizer["AppName"])
        };
        var result = await MailSender.SendMailMessageAsync(message);
        HttpContext.SetFlashMessage(result > 0 ? "TestMailSent" : "TestMailFailed", result > 0);
        Navigator.NavigateTo(Navigator.Uri);
    }
}