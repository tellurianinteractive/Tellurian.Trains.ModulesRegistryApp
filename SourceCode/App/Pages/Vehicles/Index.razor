@page "/vehicles/admin"
@page "/vehicles/admin/country/{CountryId:int}"
@page "/vehicles/"
@page "/vehicles/country/{CountryId:int}"

@attribute [Authorize(Policy = "Admin")]
@* Static SSR (Migration step 3.3): the country is chosen with a GET form to /vehicles/admin?country=..., which redirects to
   the country's address; the list and its filter are in VehiclesList. The addresses start with /vehicles/admin, so the
   menu's Vehicles link doesn't also light up for My vehicles (/vehicles/my); the old /vehicles addresses redirect. *@

@inject NavigationManager Navigator
@inject VehicleService VehicleService
@inject CountryService CountryService

<PageHeading Label="Vehicles" IconClass="@FontAwesome.Train" PageAction="@PageAction.List"></PageHeading>

<ListboxForm Id="vehicles-country" Action="vehicles/admin" Name="country" Items="Countries" ItemType="Country" SelectedId="CountryId" />
<hr />
<VehiclesList Vehicles="Vehicles" MayEdit="true" ShowOwner="true" AddHrefFunc="AddHref" EditHrefFunc="EditHref" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CountryId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public int? SelectedCountryId { get; set; }

    ClaimsPrincipal? Principal;
    IEnumerable<ListboxItem>? Countries;
    IEnumerable<Vehicle> Vehicles = [];

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Countries = await CountryService.ListboxItemsAsync(Principal);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CountryId < 1 || !IsAdminAddress)
        {
            var id = CountryId > 0 ? CountryId : SelectedCountryId > 0 ? SelectedCountryId.Value : Principal.CountryId();
            Navigator.NavigateTo($"vehicles/admin/country/{id}");
            return;
        }
        Vehicles = await VehicleService.GetVehiclesByOwnerCountryAsync(Principal, CountryId);
    }

    bool IsAdminAddress => Navigator.ToBaseRelativePath(Navigator.Uri).StartsWith("vehicles/admin", StringComparison.OrdinalIgnoreCase);
    string EditHref(Vehicle vehicle) => $"/vehicles/{vehicle.Id}/country/{CountryId}/edit";
    string AddHref() => $"vehicles/0/country/{CountryId}/edit";
}