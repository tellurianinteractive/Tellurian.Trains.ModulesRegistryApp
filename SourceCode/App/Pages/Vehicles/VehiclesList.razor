@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator

@* The vehicle list of the static SSR pages Vehicles and My vehicles (Migration step 3.3), as the persons list: the filter
   fields are in the column headers (FilterColumn), joined to the GET form vehicles-filter, so filter, sort and page are in
   the query string. *@

@if (MayEdit)
{
    <span>
        <AppButton Href="@AddHref()" Label="Add" />
    </span>
}
<hr/>

<form id="vehicles-filter" method="get" data-auto-submit data-enhance class="noprint">
    @if (Sort.HasValue())
    {
        <input type="hidden" name="sort" value="@Sort" />
        <input type="hidden" name="direction" value="@Direction" />
    }
    <button type="submit" class="visually-hidden">@Localizer["Filter"]</button>
</form>

<div class="grid" tabindex="-1">
    <QuickGrid Items="FilteredVehicles" Pagination="PaginationState">
        @if (ShowOwner)
        {
            <FilterColumn Title="@Localizer["Owner"]" Property="v => v.OwningPerson.Name()" Sortable="true" FilterForm="vehicles-filter" FilterName="owner" FilterValue="@OwnerName" />
        }
        <TemplateColumn Context="v">
            @v.ImageIcon()
        </TemplateColumn>
        <FilterColumn Title="@Localizer["PrototypeInfo"]" Property="v => v.PrototypeInfo()" Sortable="true" FilterForm="vehicles-filter" FilterName="prototype" FilterValue="@PrototypeInfo" />
        <FilterColumn Title="@Localizer["ModelInfo"]" Property="v => v.ModelInfo()" Sortable="true" FilterForm="vehicles-filter" FilterName="model" FilterValue="@ModelInfo" />
        <PropertyColumn Title="@Localizer["Scale"]" Property="v => v.Scale.Display()" Sortable="true" />
        <PropertyColumn Title="@Localizer["Period"]" Property="v => v.PeriodInfo()" Sortable="true" />
        <TemplateColumn Title="@Localizer["Features"]" Context="vehicle">
            @vehicle.Features(Localizer)
        </TemplateColumn>
        <PropertyColumn Title="@Localizer["InventoryNumber"]" Property="v => v.InventoryNumber" Sortable="true" Align="Align.Right"></PropertyColumn>
        <TemplateColumn Title="@Localizer["Actions"]" Context="vehicle" Class="noprint">
            <HeaderTemplate Context="column">
                <div class="col-title"><div class="col-title-text">@column.Title</div></div>
                @if (Filter.HasFilter)
                {
                    <div class="col-filter-clear"><AppButton Label="ClearFilter" Href="@ClearFilterHref" IconName="@FontAwesome.Erase" /></div>
                }
            </HeaderTemplate>
            <ChildContent>
                @if (MayEdit)
                {
                    <AppButton Href="@EditHref(vehicle)" Label="Edit" />
                }
            </ChildContent>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="PaginationState" />

@code {
    [Parameter] public IEnumerable<Vehicle>? Vehicles { get; set; }
    [Parameter] public bool MayEdit { get; set; }
    [Parameter] public bool ShowOwner { get; set; }
    [Parameter] public Func<string>? AddHrefFunc { get; set; }
    [Parameter] public Func<Vehicle, string>? EditHrefFunc { get; set; }
    [SupplyParameterFromQuery(Name = "owner")] public string? OwnerName { get; set; }
    [SupplyParameterFromQuery(Name = "prototype")] public string? PrototypeInfo { get; set; }
    [SupplyParameterFromQuery(Name = "model")] public string? ModelInfo { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "direction")] public string? Direction { get; set; }

    PaginationState PaginationState = new() { ItemsPerPage = 30 };

    // Without the owner column, its filter isn't shown, so it doesn't apply either.
    VehiclesFilter Filter => new() { OwnerName = ShowOwner ? OwnerName : null, PrototypeInfo = PrototypeInfo, ModelInfo = ModelInfo };

    IQueryable<Vehicle> FilteredVehicles => Vehicles is null ? Enumerable.Empty<Vehicle>().AsQueryable() : Filter.Apply(Vehicles).AsQueryable();

    string ClearFilterHref => Navigator.GetUriWithQueryParameters(new Dictionary<string, object?> { ["owner"] = null, ["prototype"] = null, ["model"] = null, ["page"] = null });
    string? AddHref() => AddHrefFunc is not null ? AddHrefFunc() : null;
    string? EditHref(Vehicle vehicle) => EditHrefFunc is not null ? EditHrefFunc(vehicle) : null;
}