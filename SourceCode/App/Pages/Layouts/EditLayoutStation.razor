@page "/LayoutStations/{id:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6): a station's settings in a layout, posted as LayoutStationFormData, for its participant while
   the layout is open or a layout organiser (LayoutService). The dependent settings are made consistent when saved, so no field is
   disabled. After saving, a redirect to the layout's modules; the result is a one-time message. *@

@using ModulesRegistry.Forms.Layouts

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject CountryService CountryService
@inject LayoutService LayoutService

<PageHeading Context="Existing" ObjectName="Station" IconClass="@FontAwesome.Layout" PageAction="PageAction.Edit" HelpContext="Layout" ShowHelpInitially="false" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

<EditTemplate Item="Form" FormName="layout-station" OnValidSubmit="SaveAsync">
    <Inputs>
        <AppInputCheck Width="3" Label="IsManned" @bind-Value="Form!.IsManned" AlignWithFields="true" />
        <AppInputCheck Width="3" Label="HidePassingTrains" @bind-Value="Form!.HidePassingTrains" AlignWithFields="true" />
        <AppInputCheck Width="3" Label="HideMeetingTrains" @bind-Value="Form!.HideMeetingTrains" AlignWithFields="true" />
        <AppInputCheck Width="3" Label="PrintTrainStartLabels" @bind-Value="Form!.PrintTrainStartLabels" AlignWithFields="true" />
        <AppInputCheck Width="3" Label="PrintOnlyFirstTrainStartLabel" @bind-Value="Form!.PrintOnlyFirstTrainStartLabel" AlignWithFields="true" />
        <AppInputSelect Width="3" @bind-Value="Form!.Difficulty" Label="DifficultyLevel" Items="DifficultyLevelItems" />
        <h4>@Localizer["OtherNameOrCountry"]</h4>
        <AppInputText Width="4" @bind-Value="Form!.OtherName" Label="OtherName" />
        <AppInputText Width="3" @bind-Value="Form!.OtherSignature" Label="OtherSignature" />
        <AppInputSelectNullable Width="3" @bind-Value="Form!.OtherCountryId" Label="OtherCountry" Items="CountryItems" ShowNoneOption="true" />
    </Inputs>
</EditTemplate>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "layout-station")] private LayoutStationFormData? Form { get; set; }

    ClaimsPrincipal? Principal;
    LayoutStation? Existing;
    IEnumerable<ListboxItem> CountryItems = [];
    readonly IEnumerable<ListboxItem> DifficultyLevelItems = EnumExtensions.LayoutStationDifficultyLevel();
    string? FailureMessage;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Existing = Id > 0 ? await LayoutService.GetLayoutStationAsync(Principal, Id) : null;
        if (Existing is null || !await LayoutService.MayEditLayoutStationAsync(Principal, Existing.Id))
        {
            Form = null; // Shows "no records"; also when a form was posted.
            return;
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= Existing.AsFormData();
        CountryItems = await CountryService.ListboxItemsAsync(Principal, allCountries: true);
    }

    string BackHref => Existing?.LayoutParticipant is { } participant ? $"Layouts/{participant.LayoutId}/Modules" : "Meetings/Index";

    async Task SaveAsync()
    {
        if (Form is null || Existing is null) return;
        var layoutId = Existing.LayoutParticipant.LayoutId;
        // Only the form's fields change on the loaded layout station (Migration section 3.4, the data-loss rule).
        var station = Form.AsEntity(Existing);
        var (count, message, _) = await LayoutService.UpdateAsync(Principal, station);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo($"Layouts/{layoutId}/Modules");
    }
}