@page "/Meetings/{meetingid:int}/Layouts/{id:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6): a meeting's layout, posted as LayoutFormData. A new layout or another organising group by the
   meeting's organisers, the rest also by the layout's organisers (LayoutService); others see the form without Save. The contact
   person is chosen among the members of the stored (or posted) organising group. The maximum number of participants is always
   shown, since a hidden field isn't posted. After saving, a redirect to this form; the result is a one-time message. *@

@using ModulesRegistry.Forms.Layouts

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject MeetingService MeetingService
@inject LayoutService LayoutService
@inject GroupService GroupService
@inject ModuleStandardService ModuleStandardService

<PageHeading Context="Existing" ObjectName="Layout" IconClass="@FontAwesome.Layout" PageAction="Id.ToAddOrEditPageAction()" HelpContext="Layout" ShowHelpInitially="false" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

<EditTemplate Item="Form" FormName="layout" OnValidSubmit="SaveAsync" ShowSaveButton="MayEdit">
    <Inputs>
        <AppFormRow>
            <AppInputSelect Width="4" @bind-Value="Form!.OrganisingGroupId" Label="ResponsibleGroup" Items="ResponsibleGroupItems" ShowPleaseSelect="true" />
            <AppInputSelect Width="3" @bind-Value="Form!.PrimaryModuleStandardId" Label="PrimaryModuleStandard" Items="ModuleStandardItems" ShowPleaseSelect="true" />
            <AppInputSelectNullable Width="3" @bind-Value="Form!.ContactPersonId" Label="ContactPerson" Items="ContactPersonItems" ShowNoneOption="true" />
        </AppFormRow>
        <AppFormRow>
            <AppInputText Width="3" @bind-Value="Form!.ShortName" Label="Name" />
            <AppInputText Width="5" @bind-Value="Form!.Theme" Label="Theme" />
        </AppFormRow>
        <AppFormRow>
            <AppInputDate Width="2" @bind-Value="Form!.RegistrationOpeningDate" Label="RegistrationOpens" />
            <AppInputDate Width="2" @bind-Value="Form!.RegistrationClosingDate" Label="RegistrationCloses" />
            <AppInputDateNullable Width="2" @bind-Value="Form!.ModuleRegistrationClosingDate" Label="ModuleRegistrationCloses" />
            <AppInputNumber TValue="int?" Width="2" @bind-Value="Form!.MaxNumberOfParticipants" Label="MaxNumberOfParticipants" />
        </AppFormRow>
        <AppCheckGroup>
            <AppInputCheck Label="IsRegistrationPermitted" @bind-Value="Form!.IsRegistrationPermitted" />
        </AppCheckGroup>
        <h4>@Localizer["GameSettings"]</h4>
        <AppFormRow>
            <AppInputNumber TValue="int?" Width="2" @bind-Value="Form!.FirstYear" Label="FirstYear" />
            <AppInputNumber TValue="int?" Width="2" @bind-Value="Form!.LastYear" Label="LastYear" />
        </AppFormRow>
        <AppInputMarkdown @bind-Value="Form!.Details" Label="Note" MaxNumberOfCharacters="LayoutFormData.MaxNoteLength" />
    </Inputs>
</EditTemplate>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int MeetingId { get; set; }
    [SupplyParameterFromForm(FormName = "layout")] private LayoutFormData? Form { get; set; }

    ClaimsPrincipal? Principal;
    Meeting? Meeting;
    Layout? Existing;
    IEnumerable<ListboxItem>? ResponsibleGroupItems;
    IEnumerable<ListboxItem>? ModuleStandardItems;
    IEnumerable<ListboxItem>? ContactPersonItems;
    bool MayEdit;
    string? FailureMessage;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Meeting = MeetingId > 0 ? await MeetingService.FindByIdAsync(MeetingId) : null;
        if (Meeting is null)
        {
            Form = null; // Shows "no records"; also when a form was posted.
            return;
        }
        if (Id > 0)
        {
            Existing = Meeting.Layouts.SingleOrDefault(l => l.Id == Id);
            if (Existing is null)
            {
                Form = null;
                return;
            }
            MayEdit = await MeetingService.IsLayoutOrganiser(Principal, Existing.Id);
        }
        else
        {
            MayEdit = await MeetingService.IsAdministratorOrMeetingOrganiser(Principal, Meeting.Id);
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= (Existing ?? new Layout
        {
            MeetingId = MeetingId,
            OrganisingGroupId = Meeting.OrganiserGroupId,
            RegistrationOpeningDate = Meeting.StartDate.AddMonths(-6),
            RegistrationClosingDate = Meeting.StartDate.AddMonths(-2),
        }).AsFormData();
        ResponsibleGroupItems = await GroupService.ListboxItemsAsync(Principal, Meeting.OrganiserGroup?.CountryId);
        ModuleStandardItems = await ModuleStandardService.LayoutListboxItemsAsync(Principal, Meeting.CountryId(), Existing?.PrimaryModuleStandardId); // National standards only of the meeting's country.
        ContactPersonItems = await GroupService.MemberListboxItemsAsync(Principal, Form.OrganisingGroupId);
    }

    string BackHref => $"Meetings/{MeetingId}/Layouts/Edit";

    async Task SaveAsync()
    {
        if (Form is null || Meeting is null || !MayEdit) return;
        // Edit: only the form's fields change on the loaded layout (Migration chapter C.4, the data-loss rule).
        var layout = Form.AsEntity(Existing, meetingId: Meeting.Id);
        var (count, message, saved) = await LayoutService.SaveAsync(Principal, layout);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo($"Meetings/{Meeting.Id}/Layouts/{(saved ?? layout).Id}");
    }
}