@page "/Modules/Index"
@page "/Modules/Country/{CountryId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.3), as the persons list: the filter fields are in the column headers (FilterColumn), joined to
   the GET form modules-filter, so filter, sort and page are in the query string. The country is chosen with a GET form to
   /Modules/Index?country=..., which redirects to the country's address. *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator

@inject ModuleService ModuleService
@inject CountryService CountryService
@inject GroupService GroupService

<PageHeading ObjectName="Modules" IconClass="@FontAwesome.Modules" PageAction="@PageAction.List" />
<ListboxForm Id="modules-country" Action="Modules/Index" Name="country" Items="Countries" ItemType="Country" IsVisible="IsSelectCountryVisible" SelectedId="CountryId" />
@if (Groups.Any())
{
    @* Part of the filter form: the modules the group owns or its members own a share of (ModuleService). *@
    <select name="group" form="modules-filter" class="form-control-sm noprint" aria-label="@Localizer["Group"]" style="margin-bottom: 4px">
        <option value="">@Localizer["AllGroups"]</option>
        @foreach (var item in Groups)
        {
            <option value="@item.Id" selected="@(item.Id == GroupId)">@item.Description</option>
        }
    </select>
}
<hr />

<form id="modules-filter" method="get" data-auto-submit data-enhance class="noprint">
    @if (Sort.HasValue)
    {
        <input type="hidden" name="sort" value="@Sort" />
        <input type="hidden" name="direction" value="@Direction" />
    }
    <button type="submit" class="visually-hidden">@Localizer["Filter"]</button>
</form>

<div class="grid" tabindex="-1">
    <QuickGrid Items="FilteredModules" Pagination="PaginationState">
        <FilterColumn Title="@Localizer["Scale"]" Property="p => p.Scale.Display()" Sortable="true" FilterForm="modules-filter" FilterName="scale" FilterValue="@Scale" />
        <FilterColumn Title="@Localizer["Name"]" Property="p => p.NameOrStationNameWithSignature()" Sortable="true" FilterForm="modules-filter" FilterName="name" FilterValue="@ModuleName" />
        <TemplateColumn Context="module" Title="@Localizer["Description"]">
            <span>@module.Description(true)</span>
        </TemplateColumn>
        <TemplateColumn Context="module" Title="@Localizer["Status"]" Align="Align.Center">
            <span>@module.StatusIcon()</span>
        </TemplateColumn>
        <TemplateColumn Context="module">
            <span>
                <DocumentLink DocumentId="module.PdfDocumentationId" FileExtension="pdf" />
                <DocumentLink DocumentId="module.DwgDrawingId" FileExtension="dwg" />
                <DocumentLink DocumentId="module.SkpDrawingId" FileExtension="skp" />
            </span>
        </TemplateColumn>
        <FilterColumn Title="@Localizer["Owners"]" Property="p => p.OwnerNames()" Sortable="true" FilterForm="modules-filter" FilterName="owner" FilterValue="@OwnerName" />
        <TemplateColumn Context="module" Title="@Localizer["Actions"]">
            <HeaderTemplate Context="column">
                <div class="col-title"><div class="col-title-text">@column.Title</div></div>
                @if (Filter.HasFilter)
                {
                    <div class="col-filter-clear"><AppButton Label="ClearFilter" Href="@ClearFilterHref" IconName="@FontAwesome.Erase" /></div>
                }
            </HeaderTemplate>
            <ChildContent>
                @if (IsAdministrator)
                {
                    <AppButton Label="Edit" IconName="@FontAwesome.Module" Href="@EditModuleHref(module)" IsDisabled="(!MayEdit(module))" />
                    @if (module.IsPrimaryStationModule())
                    {
                        <AppButton Label="Edit" IconName="@FontAwesome.Station" Href="@EditStationHref(module)" IsDisabled="(!MayEdit(module))" />
                        @if (module.Station.HasCargoCustomers == true)
                        {
                            <AppButton Label="Edit" IconName="@FontAwesome.Customer" Href="@EditStationCustomersHref(module)" IsDisabled="(!MayEdit(module))" />
                        }
                    }
                }
            </ChildContent>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="PaginationState" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int CountryId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public int? SelectedCountryId { get; set; }
    [SupplyParameterFromQuery(Name = "group")] public int? GroupId { get; set; }
    [SupplyParameterFromQuery(Name = "scale")] public string? Scale { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? ModuleName { get; set; }
    [SupplyParameterFromQuery(Name = "owner")] public string? OwnerName { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "direction")] public string? Direction { get; set; }

    private ClaimsPrincipal? Principal;
    private IEnumerable<Module> Modules = [];
    PaginationState PaginationState = new() { ItemsPerPage = 20 };
    private IEnumerable<ListboxItem>? Countries;
    private IEnumerable<ListboxItem> Groups = [];

    ModulesFilter Filter => new() { Scale = Scale, ModuleName = ModuleName, OwnerName = OwnerName, GroupId = GroupId };

    private bool IsSelectCountryVisible => Countries is not null && Countries.Count() > 1;
    // The Actions column is shown to all, since it also holds Clear filter; its buttons only to administrators, as before.
    private bool IsAdministrator => Principal.IsGlobalOrCountryAdministrator(CountryId);
    private bool MayEdit(Module module) => IsAdministrator || module.OwningPersonsIds().Contains(Principal.PersonId());

    protected async override Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Countries = await CountryService.ListboxItemsAsync(Principal);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CountryId < 1)
        {
            var id = SelectedCountryId > 0 ? SelectedCountryId.Value : Principal.CountryId();
            Navigator.NavigateTo($"Modules/Country/{id}");
            return;
        }
        Groups = await GroupService.CountryListboxItemsAsync(Principal, CountryId);
        Modules = await ModuleService.GetAllInCountryAsync(Principal, CountryId, groupId: GroupId ?? 0, groupName: Filter.GroupName);
    }

    IQueryable<Module> FilteredModules => Filter.Apply(Modules).AsQueryable();

    string ClearFilterHref => Navigator.GetUriWithQueryParameters(new Dictionary<string, object?> { ["scale"] = null, ["name"] = null, ["owner"] = null, ["group"] = null, ["page"] = null });

    string EditModuleHref(Module? module) =>
        module is null ? string.Empty :
        module.IsGroupOwned() ? $"/Modules/{module.Id}/Edit/GroupOwned/{module.OwningGroupId()}" :
        $"/Modules/{module.Id}/Edit/PersonOwned/{module.OwningPersonsIds()[0]}";

    string EditStationHref(Module? module) =>
        module is null || module.StationId < 1 ? string.Empty :
        module.IsGroupOwned() ? $"/Stations/{module.StationId}/Edit/GroupOwned/{module.OwningGroupId()}" :
        $"/Stations/{module.StationId}/Edit/PersonOwned/{module.OwningPersonsIds()[0]}";

    string EditStationCustomersHref(Module? module) =>
        module is null || module.StationId < 1 ? string.Empty :
        module.IsGroupOwned() ? $"/Stations/{module.StationId}/Customers/GroupOwned/{module.OwningGroupId()}" :
        $"/Stations/{module.StationId}/Customers/PersonOwned/{module.OwningPersonsIds()[0]}";
}