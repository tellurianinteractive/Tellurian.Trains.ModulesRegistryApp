@page "/Modules/{id:int}/Transfer/PersonOwned/{owningPersonId:int}"
@page "/Modules/{id:int}/Transfer/GroupOwned/{owningGroupId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.6): a module's owners. Transfer is a link that adds ?transfer={ownership id} and shows the transfer
   form: the country of the new owner is a GET form (?country=, keeping transfer and back), and the share and new owner are posted
   as ModuleTransferFormData; "assistant only" adds the person as an assistant. Remove (an assistant) is ?remove={id} with a POST
   confirmation. ModuleOwnershipService decides what is allowed. After a transfer, a redirect to ?back= (as a person's delete page)
   or to this page; the result is a one-time message. *@

@using ModulesRegistry.Forms.Modules

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject ModuleService ModuleService
@inject ModuleOwnershipService ModuleOwnershipService
@inject PersonService PersonService
@inject GroupService GroupService
@inject CountryService CountryService

<PageHeading Label="TransferOwnership" ObjectName="@Module?.FullName" IconClass="@FontAwesome.Module" PageAction="PageAction.List" BackHref="@BackHref" />

@if (Module is null)
{
    <ActionMessage Label="ModuleOwnershipsNotFound" AlertType="warning" />
}
else
{
    <h2>@Module.FullName</h2>

    @if (FailureMessage is not null)
    {
        <ActionMessage Label="@FailureMessage" AlertType="stop" />
    }

    @if (AssistantToRemove is not null)
    {
        <div class="alert alert-warning mt-2" role="alert">
            <form method="post" @formname="remove-assistant" @onsubmit="RemoveAssistantAsync" data-enhance>
                <AntiforgeryToken />
                <input type="hidden" name="RemoveAssistantId" value="@AssistantToRemove.Id" />
                <strong>@Localizer["Remove"] @AssistantToRemove.OwnerName()?</strong>
                <AppButton Label="Remove" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
                <AppButton Label="Cancel" Href="@SelfHref()" AlwaysShowLabel="true" />
            </form>
        </div>
    }

    <TableTemplate Items="Module.ModuleOwnerships">
        <TableHeader>
            <th>@Localizer["Owner"]</th>
            <th>@Localizer["OwnedShare"]</th>
            <th>@Localizer["Actions"]</th>
        </TableHeader>
        <RowTemplate Context="item">
            <td>@item.OwnerName()</td>
            <td>@item.OwnedShareText(Localizer)</td>
            <td>
                @if (IsTransferable(item))
                {
                    <AppButton Label="Transfer" Href="@SelfHref($"transfer={item.Id}")" />
                }
                @if (item.IsAssistantOnly())
                {
                    <AppButton Label="Remove" Href="@SelfHref($"remove={item.Id}")" />
                }
            </td>
        </RowTemplate>
    </TableTemplate>

    @if (Origin is not null && Form is not null)
    {
        <h3 class="mt-3">@Localizer["Transfer"] @Origin.OwnerName()</h3>
        <ListboxForm Id="transfer-country" Action="@SelfHref()" Name="country" Items="Countries" ItemType="Country" SelectedId="CountryId" HiddenFields="CountryFormFields" />

        <EditTemplate Item="Form" FormName="transfer" OnValidSubmit="TransferAsync">
            <Inputs>
                <input type="hidden" name="Form.OriginId" value="@Origin.Id" />
                <AppInputSelect Width="2" Label="TransferredShare" Items="ShareItems" @bind-Value="Form!.ShareIndex" />
                <AppInputSelectNullable Width="3" Label="NewPersonalOwner" Items="Persons" @bind-Value="Form!.NewPersonId" ShowNoneOption="true" />
                @if (Origin.GroupId is null)
                {
                    @* A group's module goes to one of its members; only persons' modules go to a group. *@
                    <AppInputSelectNullable Width="3" Label="NewGroupOwner" Items="Groups" @bind-Value="Form!.NewGroupId" ShowNoneOption="true" />
                }
            </Inputs>
        </EditTemplate>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int OwningPersonId { get; set; }
    [Parameter] public int OwningGroupId { get; set; }
    /// <summary>A page to go back to, as the person's delete page; only an address within the app.</summary>
    [SupplyParameterFromQuery(Name = "back")] public string? Back { get; set; }
    [SupplyParameterFromQuery(Name = "transfer")] private int? TransferId { get; set; }
    [SupplyParameterFromQuery(Name = "remove")] private int? RemoveId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] private int? SelectedCountryId { get; set; }
    [SupplyParameterFromForm(FormName = "transfer")] private ModuleTransferFormData? Form { get; set; }
    [SupplyParameterFromForm(FormName = "remove-assistant")] private int RemoveAssistantId { get; set; }

    ClaimsPrincipal? Principal;
    Module? Module;
    ModuleOwnership? Origin;
    IEnumerable<ListboxItem> Countries = [];
    IEnumerable<ListboxItem> Persons = [];
    IEnumerable<ListboxItem> Groups = [];
    int CountryId;
    string? FailureMessage;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Module = await ModuleService.FindByIdAsync(Principal, Id, OwnershipRef);
        if (Module is null) return;
        // On a POST the origin is posted; on a GET it is in the address. Only an ownership of this module that the address' owner holds.
        var originId = Form?.OriginId > 0 ? Form.OriginId : TransferId ?? 0;
        Origin = Module.ModuleOwnerships.FirstOrDefault(mo => mo.Id == originId && IsTransferable(mo));
        if (Origin is null)
        {
            Form = null;
            return;
        }
        Form ??= new ModuleTransferFormData { OriginId = Origin.Id };
        Form.OriginId = Origin.Id;
        CountryId = SelectedCountryId ?? await CurrentOwnerCountryIdAsync();
        Countries = await CountryService.ListboxItemsAsync(Principal, true, true);
        Persons = await PersonService.ListboxItemsAsync(Principal, CountryId);
        Groups = await GroupService.ListboxItemsAsync(Principal, CountryId);
    }

    ModuleOwnershipRef OwnershipRef =>
        OwningGroupId > 0 ? ModuleOwnershipRef.Group(OwningGroupId) :
        OwningPersonId > 0 ? ModuleOwnershipRef.Person(OwningPersonId) :
        Principal.OwnerRef();

    bool IsTransferable(ModuleOwnership ownership) => ownership.ISOwnedByPerson(OwningPersonId) || ownership.IsOwnedByGroup(OwningGroupId);

    ModuleOwnership? AssistantToRemove => RemoveId > 0 ? Module?.ModuleOwnerships.FirstOrDefault(mo => mo.Id == RemoveId && mo.IsAssistantOnly()) : null;

    async Task<int> CurrentOwnerCountryIdAsync()
    {
        if (OwningGroupId > 0 && await GroupService.FindByIdAsync(Principal, OwningGroupId) is { } group) return group.CountryId;
        if (OwningPersonId > 0 && await PersonService.FindByIdAsync(Principal, OwningPersonId) is { } person) return person.CountryId;
        return Principal.CountryId();
    }

    // A group's module goes whole; a person gives at most their share, or makes someone an assistant.
    IEnumerable<ListboxItem> ShareItems =>
        Origin is null ? [] :
        ModuleTransferFormData.Shares
            .Where(s => Origin.GroupId > 0 ? s.Index == 1 : s.Percentage <= Origin.OwnedShare + 0.0001)
            .Select(s => new ListboxItem(s.Index, s.Percentage > 0 ? $"1/{s.Index}" : Localizer["AssistantOnly"].Value));

    IReadOnlyDictionary<string, string> CountryFormFields => Back is { Length: > 0 } back
        ? new Dictionary<string, string> { ["transfer"] = $"{Origin?.Id}", ["back"] = back }
        : new Dictionary<string, string> { ["transfer"] = $"{Origin?.Id}" };

    string? BackHref => Back is { Length: > 0 } back && back[0] is not ('/' or '\\') && !back.Contains(':') ? back : null;

    string SelfHref(string? query = null)
    {
        var path = OwningGroupId > 0 ? $"Modules/{Id}/Transfer/GroupOwned/{OwningGroupId}" : $"Modules/{Id}/Transfer/PersonOwned/{OwningPersonId}";
        List<string> parameters = [];
        if (query is not null) parameters.Add(query);
        if (BackHref is not null) parameters.Add($"back={Uri.EscapeDataString(BackHref)}");
        return parameters.Count == 0 ? path : $"{path}?{string.Join('&', parameters)}";
    }

    async Task TransferAsync()
    {
        if (Form is null || Origin is null || Module is null) return;
        int count;
        string? message;
        if (Form.IsAssistantOnly)
        {
            (count, message, _) = await ModuleOwnershipService.AddAssistantAsync(Principal, new ModuleOwnership { ModuleId = Module.Id, PersonId = Form.NewPersonId, OwnedShare = 0 });
        }
        else
        {
            // A group always gets the whole module (ModuleOwnershipService).
            var newOwnership = new ModuleOwnership { ModuleId = Module.Id, PersonId = Form.NewPersonId > 0 ? Form.NewPersonId : null, GroupId = Form.NewGroupId > 0 ? Form.NewGroupId : null };
            newOwnership.OwnedShare = newOwnership.GroupId > 0 ? 1 : Form.Percentage;
            (count, message, _) = await ModuleOwnershipService.TransferOwnershipAsync(Principal, Origin.Id, newOwnership);
        }
        if (count <= 0)
        {
            FailureMessage = message;
            return;
        }
        HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        Navigator.NavigateTo(!Form.IsAssistantOnly && BackHref is not null ? BackHref : SelfHref());
    }

    async Task RemoveAssistantAsync()
    {
        var assistant = Module?.ModuleOwnerships.FirstOrDefault(mo => mo.Id == RemoveAssistantId && mo.IsAssistantOnly());
        if (assistant is null) return;
        var removed = (await ModuleOwnershipService.RemoveAssistantAsync(Principal, assistant)).Count > 0;
        HttpContext.SetFlashMessage(removed ? "DeletedSuccessfully" : "DeleteFailed", removed);
        Navigator.NavigateTo(SelfHref());
    }
}