@page "/Modules/{id:int}/Edit/PersonOwned/{PersonId:int}"
@page "/Modules/{id:int}/Edit/GroupOwned/{GroupId:int}"
@page "/Modules/{id:int}/Edit/PersonOwned/{PersonId:int}/InGroup/{GroupId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6), as the station form: a POST of ModuleFormData, validated in the browser and again on the
   server; the id comes from the address. A new module is added for the owner in the address (person or group) by a user who may
   add modules for that owner; an existing module is edited by a user who may edit it (MayEditModuleAsync, assistants included).
   The length is calculated from radius, angle and straight when saved. The exits are listed below, each edited on its own form
   (ExitEdit.razor); Delete is ?deleteExit={id} with a POST confirmation. The documents are uploaded with static forms
   (DocumentUploadForm). After saving, a redirect to this form, which reads the module back; the result is a one-time message. *@

@using ModulesRegistry.Forms.Modules

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject ModuleService ModuleService
@inject StationService StationService
@inject ModuleStandardService ModuleStandardService
@inject LocalityService LocalityService

<PageHeading ObjectName="Module" Context="@Existing" IconClass="@FontAwesome.Module" PageAction="@Id.ToAddOrEditPageAction()" HelpContext="Module" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

<EditTemplate Item="Form" FormName="module" OnValidSubmit="SaveAsync">
    <Inputs>
        <AppFormRow>
            <AppInputSelect Width="3" Label="Standard&Scale" @bind-Value="Form!.StandardId" Items="ModuleStandardItems" ShowPleaseSelect="true" />
            <AppInputText Width="5" Label="Name" @bind-Value="Form!.FullName" />
            <AppInputText Width="1" Label="ConfigurationLabel" @bind-Value="Form!.ConfigurationLabel" />
            <AppInputText Width="1" Label="PackageLabel" @bind-Value="Form!.PackageLabel" />
            <AppInputNumber TValue="int?" Width="1" Label="FremoNumber" @bind-Value="Form!.FremoNumber" />
            <AppInputNumber TValue="int?" Width="1" Label="NumberOfSections" @bind-Value="Form!.NumberOfSections" />
        </AppFormRow>
        <AppFormRow>
            <AppInputSelect Width="2" Label="Visibility" @bind-Value="Form!.ObjectVisibilityId" Items="EnumExtensions.ObjectVisibilityListboxItems()" ShowPleaseSelect="false" />
            <AppInputSelect Width="2" Label="FunctionalState" @bind-Value="Form!.FunctionalState" Items="EnumExtensions.ModuleFunctionalStateListboxItems()" ShowPleaseSelect="false" />
            <AppInputSelect Width="2" Label="LandscapeState" @bind-Value="Form!.LandscapeState" Items="EnumExtensions.ModuleLandscapeStateListboxItems()" ShowPleaseSelect="false" />
            <AppInputSelect Width="2" Label="LandscapeSeason" @bind-Value="Form!.LandscapeSeason" Items="EnumExtensions.LandscapeSeasonListboxItems()" ShowPleaseSelect="false" />
            <AppInputSelect Width="2" Label="SignalFeature" @bind-Value="Form!.SignalFeature" Items="EnumExtensions.SignalFeatureListboxItems()" ShowPleaseSelect="false" />
            <AppInputSelect Width="2" Label="OverheadLineFeature" @bind-Value="Form!.OverheadLineFeature" Items="EnumExtensions.OverheadLineFeatureListboxItems()" ShowPleaseSelect="false" />
        </AppFormRow>
        <AppFormRow>
            <AppInputSelectNullable Width="3" Label="IsStationOrPartOf" @bind-Value="Form!.StationId" Items="StationItems" ShowNoneOption="true" />
            <AppInputNumber TValue="int?" Width="1" Label="RepresentsFromYear" @bind-Value="Form!.RepresentsFromYear" />
            <AppInputNumber TValue="int?" Width="1" Label="RepresentsToYear" @bind-Value="Form!.RepresentsUptoYear" />
            <AppInputText Width="3" Label="ThemeNote" @bind-Value="Form!.Theme" />
            <AppInputSelectNullable Width="4" Label="StoredAt" @bind-Value="Form!.StoredAtLocalityId" Items="StorageItems" ShowNoneOption="true" NoneLabel="None" IsDisabled="@IsStorageHidden" />
        </AppFormRow>
        <AppFormRow>
            <AppInputNumber TValue="double?" Width="1" Label="Radius" @bind-Value="Form!.Radius" Unit="mm" />
            <AppInputNumber TValue="double?" Width="1" Label="Angle" @bind-Value="Form!.Angle" Unit="°" Step=".1" />
            <AppInputNumber TValue="double?" Width="1" Label="Straight" @bind-Value="Form!.Straight" Unit="mm" Step="1" />
            <div class="@FormColumn.Css(1)">
                <label class="form-control-label text-end">@Localizer["Length"]&nbsp;mm</label>
                <div class="form-control text-end" aria-readonly="true">@(Existing?.Length.ToString("0") ?? "")</div>
            </div>
            <AppInputNumber TValue="double?" Width="1" Label="Width" @bind-Value="Form!.Width" Unit="mm" Step="1" />
            <AppInputNumber TValue="int?" Width="1" Label="MaxSpeed" @bind-Value="Form!.SpeedLimit" Unit="km/h" Step="5" />
            <AppInputNumber TValue="int" Width="1" Label="NumberOfThroughTracks" @bind-Value="Form!.NumberOfThroughTracks" />
        </AppFormRow>
        <AppCheckGroup>
            <AppInputCheck Label="IsUnavailable" @bind-Value="Form!.IsUnavailable" />
            <AppInputCheck Label="IsStandAlone" @bind-Value="Form!.IsStandAlone" />
            <AppInputCheck Label="IsTurntable" @bind-Value="Form!.IsTurntable" />
            <AppInputCheck Label="IsDuckunder" @bind-Value="Form!.IsDuckunder" />
            <AppInputCheck Label="IsSignalModule" @bind-Value="Form!.IsSignalModule" />
            <AppInputCheck Label="IsEndProfileSwitcher" @bind-Value="Form!.IsEndProfileSwitcher" />
            <AppInputCheck Label="IsEndOfLine" @bind-Value="Form!.IsEndOfLine" />
            <AppInputCheck Label="HasNormalGauge" @bind-Value="Form!.HasNormalGauge" />
            <AppInputCheck Label="HasNarrowGauge" @bind-Value="Form!.HasNarrowGauge" />
            <AppInputCheck Label="HasIntegratedLocoNet" @bind-Value="Form!.HasIntegratedLocoNet" />
            @* Always shown: a hidden checkbox isn't posted, and would be saved as unchecked. *@
            <AppInputCheck Label="Is2R" @bind-Value="Form!.Is2R" />
            <AppInputCheck Label="Is3R" @bind-Value="Form!.Is3R" />
        </AppCheckGroup>

        <AppInputText Width="12" Label="Note" @bind-Value="Form!.Note" />
    </Inputs>
    <Buttons>
        @if (Existing?.StationId is int stationId)
        {
            <AppButton Label="@Localizer.EditObject("OperationLocation")" Href="@OwnershipRef.Href("Stations", stationId, "Edit")" IconName="@FontAwesome.Station" />
        }
        else if (Existing is not null)
        {
            <AppButton Label="@Localizer["MakeAsOperationsLocation"]" Href="@StationMakeLink" IconName="@FontAwesome.Station" />
        }
    </Buttons>
</EditTemplate>

@if (Existing is not null && Form is not null)
{
    <h3 class="mt-3">@Localizer["Exits"]</h3>
    @if (ExitToDelete is not null)
    {
        <div class="alert alert-warning mt-2" role="alert">
            <form method="post" @formname="delete-exit" @onsubmit="DeleteExitAsync" data-enhance>
                <AntiforgeryToken />
                <input type="hidden" name="DeleteExitId" value="@ExitToDelete.Id" />
                <strong>@Localizer["Delete"] @ExitToDelete.Label?</strong>
                <AppButton Label="Delete" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
                <AppButton Label="Cancel" Href="@SelfHref" AlwaysShowLabel="true" />
            </form>
        </div>
    }
    <div class="col-12">
        <AppButton Label="Add" ObjectName="Exit" Href="@ExitHref(0)" />
    </div>
    <TableTemplate Items="Existing.ModuleExits.OrderBy(me => me.Label)">
        <TableHeader>
            <th>@Localizer["Direction"]</th>
            <th>@Localizer["Designation"]</th>
            <th>@Localizer["EndProfile"]</th>
            <th>@Localizer["Actions"]</th>
        </TableHeader>
        <RowTemplate Context="exit">
            <td>@DirectionText(exit.Direction)</td>
            <td>@exit.Label</td>
            <td>@exit.EndProfile?.Designation</td>
            <td style="white-space: nowrap !important;">
                <AppButton Label="Edit" Href="@ExitHref(exit.Id)" />
                <AppButton Label="Delete" Href="@($"{SelfHref}?deleteExit={exit.Id}")" />
            </td>
        </RowTemplate>
    </TableTemplate>

    <DocumentsUpload DocumentedObject="Existing">
        <Uploads>
            <DocumentUploadForm FileExtension="pdf" DocumentedObject="Existing" Label="Documentation" MaxFileSizeKb="500" ReturnHref="@SelfHref" />
            <DocumentUploadForm FileExtension="dwg" DocumentedObject="Existing" Label="Drawing" MaxFileSizeKb="500" ReturnHref="@SelfHref" />
            @if (Principal.MayUploadSkpDrawing())
            {
                <DocumentUploadForm FileExtension="skp" DocumentedObject="Existing" Label="Drawing" MaxFileSizeKb="500" ReturnHref="@SelfHref" />
            }
        </Uploads>
    </DocumentsUpload>
}

@code {
    // Reached from the static modules list, this page may have no history (Migration step 3.3).
    const string BackHref = "Modules/Index";
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int GroupId { get; set; }
    [Parameter] public int PersonId { get; set; }
    [SupplyParameterFromForm(FormName = "module")] private ModuleFormData? Form { get; set; }
    [SupplyParameterFromForm(FormName = "delete-exit")] private int DeleteExitId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteExit")] private int? DeleteExitQueryId { get; set; }

    ClaimsPrincipal? Principal;
    ModuleOwnershipRef OwnershipRef = ModuleOwnershipRef.None;
    Module? Existing;
    IEnumerable<ListboxItem>? ModuleStandardItems;
    IEnumerable<ListboxItem>? StationItems;
    IEnumerable<ListboxItem>? StorageItems;
    string? FailureMessage;

    // The module is stored at a group's storage place the user doesn't see: shown disabled and kept as it is.
    bool IsStorageHidden => Existing?.StoredAtLocalityId is int id && StorageItems?.Any(i => i.Id == id) == false;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        OwnershipRef = ModuleOwnershipRef.Any(Principal, PersonId, GroupId);
        if (Id > 0)
        {
            Existing = await ModuleService.FindForEditAsync(Principal, Id);
            if (Existing is null)
            {
                Form = null; // Shows "no records"; also when a form was posted.
                return;
            }
        }
        else if (!await ModuleService.MayAddForAsync(Principal, OwnershipRef))
        {
            Form = null;
            return;
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= (Existing ?? new Module { Is2R = true, HasNormalGauge = true, NumberOfThroughTracks = 1, ObjectVisibilityId = (int)ObjectVisibility.GroupMembers }).AsFormData();
        ModuleStandardItems = await ModuleStandardService.ModuleListboxItemsAsync(Principal, Id, OwnershipRef); // National standards only of the owners' countries.
        StorageItems = await LocalityService.StorageListboxItemsAsync(Principal, Id, OwnershipRef);
        if (IsStorageHidden)
        {
            // A disabled field isn't posted: the stored value is kept, under a placeholder instead of the locality's name.
            Form.StoredAtLocalityId = Existing!.StoredAtLocalityId;
            StorageItems = [new ListboxItem(Existing.StoredAtLocalityId!.Value, Localizer["HiddenLocality"]), .. StorageItems];
        }
        StationItems = await StationService.StationItemsAsync(Principal, OwnershipRef);
        if (Existing?.StationId is int stationId && !StationItems.Any(s => s.Id == stationId))
        {
            var station = await StationService.FindByIdAsync(Principal, stationId);
            if (station is not null) StationItems = [new ListboxItem(station.Id, station.FullName), .. StationItems];
        }
    }

    ModuleExit? ExitToDelete => DeleteExitQueryId > 0 ? Existing?.ModuleExits.FirstOrDefault(e => e.Id == DeleteExitQueryId) : null;

    string OwnerSuffix =>
        PersonId > 0 && GroupId > 0 ? $"PersonOwned/{PersonId}/InGroup/{GroupId}" :
        GroupId > 0 ? $"GroupOwned/{GroupId}" : $"PersonOwned/{PersonId}";

    string EditHref(int moduleId) => $"Modules/{moduleId}/Edit/{OwnerSuffix}";
    string SelfHref => EditHref(Id);
    string ExitHref(int exitId) => $"Modules/{Id}/Exits/{exitId}/Edit?back={Uri.EscapeDataString(SelfHref)}";

    string StationMakeLink =>
        OwnershipRef.IsGroup ? $"Stations/Create/{Id}/GroupOwned/{OwnershipRef.GroupId}" :
        $"Stations/Create/{Id}/PersonOwned/{OwnershipRef.PersonId}";

    static string DirectionText(int direction) =>
        EnumExtensions.StationEntryDirectionsListboxItems().FirstOrDefault(i => i.Id == direction)?.Description ?? string.Empty;

    async Task SaveAsync()
    {
        if (Form is null) return;
        // Edit: only the form's fields change on the loaded module (Migration chapter C.4, the data-loss rule).
        var module = Form.AsEntity(Existing);
        var (count, message, saved) = await ModuleService.SaveAsync(Principal, module, OwnershipRef);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo(EditHref((saved ?? module).Id));
    }

    async Task DeleteExitAsync()
    {
        // Only an exit of this module (the service also checks the user's rights for the exit's module).
        if (Existing is null || !Existing.ModuleExits.Any(e => e.Id == DeleteExitId)) return;
        var deleted = (await ModuleService.DeleteExitAsync(Principal, DeleteExitId)).Count > 0;
        HttpContext.SetFlashMessage(deleted ? "DeletedSuccessfully" : "DeleteFailed", deleted);
        Navigator.NavigateTo(SelfHref);
    }
}