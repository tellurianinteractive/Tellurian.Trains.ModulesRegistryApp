@page "/Modules/{id:int}/Delete/PersonOwned/{ownerPersonId:int}"
@page "/Modules/{id:int}/Delete/GroupOwned/{ownerGroupId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.6): deleting a module is a POST form, for a user who may delete it (its sole owner, or an
   administrator: MayDeleteModuleAsync), when it is not part of a station and not registered for a meeting that has not ended (all
   also checked by ModuleService). Afterwards, a redirect to the modules list. *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject ModuleService ModuleService

<PageHeading ObjectName="Module" Context="@Module" IconClass="@FontAwesome.Module" PageAction="PageAction.Delete" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

@if (Module is null)
{
    <ActionMessage AlertType="stop" Label="NothingToDelete" />
}
else
{
    <ul>
        <li>@Localizer["IsOnlyOwner"]: @MayDelete.AsYesOrNoWithColor()</li>
        <li>@Localizer["IsPartOfStation"]: @IsReferringStation.AsYesOrNoWithColor(true)</li>
        <li>@Localizer["IsRegisteredInUpcomingMeeting"]: @IsRegisteredInUpcomingMeeting.AsYesOrNoWithColor(true)</li>
    </ul>
    @if (MayDelete && !IsReferringStation && !IsRegisteredInUpcomingMeeting)
    {
        <form method="post" @formname="delete-module" @onsubmit="DeleteAsync" data-enhance>
            <AntiforgeryToken />
            <AppButton Label="ConfirmDelete" IconName="@FontAwesome.Delete" IsSubmit="true" AlwaysShowLabel="true" />
        </form>
    }
    else
    {
        <ActionMessage AlertType="info" Label="ConditionsForDeleteNotMet" />
    }
}

@code {
    // The modules list is static, so this page may have no history (Migration step 3.3).
    const string BackHref = "Modules/Index";
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int OwnerPersonId { get; set; }
    [Parameter] public int OwnerGroupId { get; set; }

    ClaimsPrincipal? Principal;
    Module? Module;
    bool MayDelete;
    bool IsReferringStation;
    bool IsRegisteredInUpcomingMeeting;
    string? FailureMessage;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        var ownershipRef = ModuleOwnershipRef.PersonAndOrGroup(Principal, OwnerPersonId, OwnerGroupId);
        Module = await ModuleService.FindByIdAsync(Principal, Id, ownershipRef);
        if (Module is null) return;
        MayDelete = await ModuleService.MayDeleteAsync(Principal, Module.Id);
        IsReferringStation = ModuleService.IsReferringStation(Module);
        IsRegisteredInUpcomingMeeting = await ModuleService.IsSubmittedToUpcomingMeeting(Module);
    }

    async Task DeleteAsync()
    {
        if (Module is null || !MayDelete || IsReferringStation || IsRegisteredInUpcomingMeeting) return;
        var (count, message) = await ModuleService.DeleteAsync(Principal, Module.Id);
        if (count <= 0)
        {
            FailureMessage = message;
            return;
        }
        HttpContext.SetFlashMessage("DeletedSuccessfully", FlashMessageLevel.Success);
        Navigator.NavigateTo(BackHref);
    }
}