@page "/reports/waybills/layout/{layoutId:int}"
@page "/reports/waybills/layout/{layoutId:int}/station/{stationId:int}"
@page "/reports/waybills/station/{stationId:int}"
@page "/reports/waybills/station/{stationId:int}/customer/{customerId:int}"
@page "/reports/waybills/group/{groupId:int}"

@layout PrintLayout
@attribute [StreamRendering]
@* Static SSR (Migration step 3.3a): pure print output. Streaming shows "Creating report" until the waybills are ready.
   A customer's waybills can be filtered as on the customer's waybills page (StationCustomerWaybillsFilter in the query string),
   so a print has exactly the waybills shown there. *@
@using ModulesRegistry.Pages.Stations
@inject IStringLocalizer<Strings> Localizer
@inject WaybillService WaybillService
@inject StationCustomerWaybillsService StationCustomerWaybillsService
@inject LayoutService LayoutService
@if (Waybills is null)
{
    <ActionMessage Label="CreatingReport" AlertType="Spinning" />
}
else if (Waybills.Count() == 0)
{
    <div style="padding: 1cm">
        <ContentView ContentName="NoWaybills" />
    </div>
}
else
{
    @foreach (var itemsPerPage in Waybills.ItemsPerPage(Waybill.ItemsPerPage))
    {
        <div >
            @foreach (var item in itemsPerPage)
            {
                <WaybillCard2 Item="@item"></WaybillCard2>
            }
        </div>
    }
}
@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int? StationId { get; set; }
    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public int LayoutId { get; set; }
    [Parameter] public int? LayoutStationId { get; set; }
    [Parameter] public int? GroupId { get; set; }
    [SupplyParameterFromQuery(Name = StationCustomerWaybillsFilter.FlowName)] public string? Flow { get; set; }
    [SupplyParameterFromQuery(Name = StationCustomerWaybillsFilter.StationName)] public string? OtherStation { get; set; }
    [SupplyParameterFromQuery(Name = StationCustomerWaybillsFilter.CustomerName)] public string? OtherCustomer { get; set; }
    [SupplyParameterFromQuery(Name = StationCustomerWaybillsFilter.CargoName)] public string? Cargo { get; set; }

    ClaimsPrincipal? Principal;
    IEnumerable<Waybill>? Waybills { get; set; }
    bool IsLoading = false;


    protected override async Task OnInitializedAsync()
    {
        Waybills = null;
        if (!IsLoading)
        {
            IsLoading = true;
            Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
            if (LayoutId > 0)
            {
                bool useReturnWaybills = true;
                var items = await WaybillService.GetLayoutWaybillsAsync(Principal, LayoutId, StationId);
                foreach (var item in items) if(item.QuantityIsBearer) item.HasEmptyReturn = useReturnWaybills;
                Waybills = items.AsPrintableWaybills();
            }
            else if (StationId > 0)
            {
                var items = await WaybillService.GetStationCustomerWaybillsAsync(Principal, StationId.Value, CustomerId, true, true);
                var filter = new StationCustomerWaybillsFilter { Flow = Flow, Station = OtherStation, Customer = OtherCustomer, Cargo = Cargo };
                if (CustomerId > 0 && filter.HasFilter)
                {
                    // The filter matches the texts of the waybills page, so it's applied to the same waybills, by their ids.
                    var shown = filter.Apply(await StationCustomerWaybillsService.GetStationCustomerWaybillsAsync(Principal, CustomerId.Value)).Select(w => w.Id).ToHashSet();
                    items = items.Where(w => shown.Contains(w.Id)).ToList();
                }
                Waybills = items.AsPrintableWaybills();
            }
            else if (GroupId > 0)
            {
                var items = await WaybillService.GetGroupWaybillsAsync(Principal, GroupId.Value);
                Waybills = items.AsPrintableWaybills();
            }
        }
    }
}
