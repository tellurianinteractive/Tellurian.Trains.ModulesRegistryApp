@page "/Cargo/{id:int}/Edit"

@attribute [Authorize(Policy = "Admin")]
@* Static SSR form (Migration step 3.6), as the region form: a POST of CargoFormData, validated with its DataAnnotations in the
   browser and again on the server; the id comes from the address. After saving, a redirect to this form, which reads the cargo
   back, so the user sees what was saved, including corrections; the result is a one-time message. A failed save shows the posted
   values again with the message. *@

@using ModulesRegistry.Forms.Cargos

@inject NavigationManager Navigator
@inject CargoService CargoService

<PageHeading ObjectName="Cargo" IconClass="@FontAwesome.Cargo" PageAction="@Id.ToAddOrEditPageAction()" BackHref="Cargo/Index" />

@if (FailureKey is not null)
{
    <ActionMessage Label="@FailureKey" AlertType="stop" />
}

<EditTemplate Item="Form" FormName="cargo" OnValidSubmit="SaveAsync">
    <Inputs>
        <AppInputSelect Width="12" Label="NHMCode" Items="NhmCodeItems" @bind-Value="Form!.NhmCode" ShowPleaseSelect="true" Typeahead="true" TypeaheadPlaceholder="TypeNhmCodeOrName" />

        <AppInputText Width="3" Label="DefaultClasses" @bind-Value="Form!.DefaultClasses" />
        <AppInputNumber TValue="int?" Width="2" Label="FromYear" PeriodEnd="YearPeriodEnd.From" @bind-Value="Form!.FromYear" />
        <AppInputNumber TValue="int?" Width="2" Label="UptoYear" PeriodEnd="YearPeriodEnd.Upto" @bind-Value="Form!.UptoYear" />
        <AppInputCheck Width="2" Label="IsExpress" @bind-Value="Form!.IsExpress" AlignWithFields="true" />
        <AppInputCheck Width="3" Label="IsCoolingRequired" @bind-Value="Form!.IsCoolingRequired" AlignWithFields="true" />

        <AppInputText Width="4" Label="English" @bind-Value="Form!.EN" />
        <AppInputText Width="4" Label="German" @bind-Value="Form!.DE" />
        <AppInputText Width="4" Label="Dutch" @bind-Value="Form!.NL" />

        <AppInputText Width="4" Label="French" @bind-Value="Form!.FR" />
        <AppInputText Width="4" Label="Italian" @bind-Value="Form!.IT" />
        <AppInputText Width="4" Label="Polish" @bind-Value="Form!.PL" />

        <AppInputText Width="4" Label="Danish" @bind-Value="Form!.DA" />
        <AppInputText Width="4" Label="Swedish" @bind-Value="Form!.SV" />
        <AppInputText Width="4" Label="Norwegian" @bind-Value="Form!.NB" />
    </Inputs>
</EditTemplate>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromForm(FormName = "cargo")] private CargoFormData? Form { get; set; }

    ClaimsPrincipal? Principal;
    Cargo? Existing;
    IEnumerable<ListboxItem>? NhmCodeItems;
    string? FailureKey;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        // Cargo types are shared by all countries: only global administrators change them (CargoService).
        if (!Principal.IsGlobalAdministrator())
        {
            Form = null;
            return;
        }
        if (Id > 0)
        {
            Existing = await CargoService.FindByIdAsync(Principal, Id);
            if (Existing is null)
            {
                Form = null; // Shows "no records"; also when a form was posted.
                return;
            }
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= (Existing ?? new Cargo()).AsFormData();
        NhmCodeItems = await CargoService.GetNhmItems(Principal, 0);
    }

    async Task SaveAsync()
    {
        if (Form is null) return;
        // Edit: only the form's fields change on the loaded cargo (Migration section 3.4, the data-loss rule).
        var cargo = Form.AsEntity(Existing);
        var (count, _, _) = await CargoService.SaveAsync(Principal, cargo);
        if (count == 0)
        {
            FailureKey = "SaveFailed";
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo($"Cargo/{cargo.Id}/Edit");
    }
}