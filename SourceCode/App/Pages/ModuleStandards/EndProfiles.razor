@page "/ModuleStandards/EndProfiles"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.6): the module end profiles, only text and links; Add and Edit for global administrators. The drawing
   from Module Draw, when there is one, is shown to everyone on its own page (EndProfileDrawing). *@

@using ModulesRegistry.Forms.Validation
@inject IStringLocalizer<Strings> Localizer
@inject ModuleEndProfileService ModuleEndProfileService

<PageHeading Label="ModuleEndProfiles" IconClass="@FontAwesome.Standard" PageAction="PageAction.List" />

@if (MayEdit)
{
    <AppButton Label="Add" Href="ModuleStandards/EndProfiles/0/Edit" AlwaysShowLabel="true" />
}

<TableTemplate Items="ModuleEndProfiles?.OrderBy(p => p.Scale.Denominator).ThenBy(p => p.ModuleStandard?.ShortName).ThenBy(p => p.Designation)">
    <TableHeader>
        <th>@Localizer["Scale"]</th>
        <th>@Localizer["ModuleStandard"]</th>
        <th>@Localizer["Designation"]</th>
        <th class="text-end">@Localizer["Width"]</th>
        <th class="text-end" title="@Localizer["EndProfileHeightExplanation"]">@Localizer["Height"]</th>
        <th>@Localizer["ReferenceDocument"]</th>
        @if (HasActions)
        {
            <th>@Localizer["Actions"]</th>
        }
    </TableHeader>
    <RowTemplate Context="item">
        <td>@item.Scale.Display()</td>
        <td>@item.ModuleStandard?.ShortName</td>
        <td>@item.Designation</td>
        <td class="text-end">@(item.WidthMillimeter is int width ? $"{width} mm" : null)</td>
        <td class="text-end">@(item.HeightMillimeter is int height ? $"{height} mm" : null)</td>
        <td>
            @* Only a web address is a link (TextRules.IsWebAddress), so a javascript: address can't run. *@
            @if (item.ReferenceDocumentHref.IsWebAddress() && item.ReferenceDocumentHref.HasValue)
            {
                <a href="@item.ReferenceDocumentHref" target="_blank" rel="noopener noreferrer"><span class="fa fa-external-link-alt"></span> @Localizer["ReferenceDocument"]</a>
            }
        </td>
        @if (HasActions)
        {
            <td style="white-space: nowrap">
                @* Edit first, so it is in the same place on every row; the less common buttons after it. *@
                @if (MayEdit)
                {
                    <AppButton Label="Edit" Href="@($"ModuleStandards/EndProfiles/{item.Id}/Edit")" />
                }
                @if (item.DrawingId.HasValue)
                {
                    <AppButton Label="EndProfileDrawing" Href="@($"ModuleStandards/EndProfiles/{item.Id}/Drawing")" IconName="@FontAwesome.Drawing" />
                }
            </td>
        }
    </RowTemplate>
</TableTemplate>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    ClaimsPrincipal? Principal;
    IEnumerable<ModuleEndProfile>? ModuleEndProfiles;
    bool MayEdit => Principal.IsGlobalAdministrator();
    // The column is shown to everyone when an end profile has a drawing to view; otherwise only to those who edit.
    bool HasActions => MayEdit || ModuleEndProfiles?.Any(p => p.DrawingId.HasValue) == true;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        ModuleEndProfiles = await ModuleEndProfileService.GetAllAsync();
    }
}