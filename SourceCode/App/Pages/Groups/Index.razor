@page "/Groups/Index"
@page "/Groups/Index/{countryId:int}"
@page "/Groups/Country/{countryId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.3), as the persons list: the filter fields are in the column headers (FilterColumn), joined to
   the GET form groups-filter, so filter, sort and page are in the query string. The country is chosen with a GET form to
   /Groups/Index?country=..., which redirects to the country's address. Delete, only for a group with no members, modules and
   meetings, is a link that adds ?delete={id}, which shows a confirmation with a POST form (antiforgery); after it, the result is
   a one-time message (SetFlashMessage) after the redirect, as on the external stations list. *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject GroupService GroupService
@inject CountryService CountryService

<PageHeading ObjectName="Groups" IconClass="@FontAwesome.Group" PageAction="PageAction.List" />

<ListboxForm Id="groups-country" Action="Groups/Index" Name="country" Items="Countries" ItemType="Country" IsVisible="IsSelectCountryVisible" SelectedId="CountryId" />

@if (Principal.IsCountryAdministratorInCountry(CountryId))
{
    <span class="col-12" style="margin-top: 10px">
        <AppButton Label="Add" Href="@EditHref(0)" />
    </span>
}
<hr />

@if (GroupToDelete is not null)
{
    <div class="alert alert-warning" role="alert">
        <form method="post" @formname="delete" @onsubmit="DeleteAsync" data-enhance>
            <AntiforgeryToken />
            <input type="hidden" name="DeleteGroupId" value="@GroupToDelete.Id" />
            <strong>@Localizer["Delete"] @GroupToDelete.FullName?</strong>
            <AppButton Label="ConfirmDelete" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
            <AppButton Label="Cancel" Href="@WithoutDelete" AlwaysShowLabel="true" />
        </form>
    </div>
}

<form id="groups-filter" method="get" data-auto-submit data-enhance class="noprint">
    @if (Sort.HasValue)
    {
        <input type="hidden" name="sort" value="@Sort" />
        <input type="hidden" name="direction" value="@Direction" />
    }
    <button type="submit" class="visually-hidden">@Localizer["Filter"]</button>
</form>

<div class="grid" tabindex="-1">
    <QuickGrid Items="@FilteredGroups" Pagination="PaginationState">
        <FilterColumn Property="@(p => p.Value.ShortName)" Sortable="true" Title="@Localizer["ShortName"]" FilterForm="groups-filter" FilterName="short" FilterValue="@ShortName" />
        <FilterColumn Property="@(p => p.Value.FullName)" Sortable="true" Title="@Localizer["FullName"]" FilterForm="groups-filter" FilterName="full" FilterValue="@FullName" />
        <PropertyColumn Property="@(p => CityName(p.Value))" Sortable="true" Title="@Localizer["CityName"]" />
        @if (HasGroupsFromSeveralCountries)
        {
            <FilterColumn Property="@(p => CountryNameOf(p.Value))" Sortable="true" Title="@Localizer["Country"]" FilterForm="groups-filter" FilterName="countryname" FilterValue="@CountryName" />
        }
        <PropertyColumn Property="@(p => GroupDomain(p.Value))" Sortable="true" Title="@Localizer["Domain"]" />
        <PropertyColumn Property="@(p => Localizer[p.Value.Category].Value)" Sortable="true" Title="@Localizer["Category"]" />
        <TemplateColumn Title="@Localizer["Actions"]">
            <HeaderTemplate Context="column">
                <div class="col-title"><div class="col-title-text">@column.Title</div></div>
                @if (Filter.HasFilter)
                {
                    <div class="col-filter-clear"><AppButton Label="ClearFilter" Href="@ClearFilterHref" IconName="@FontAwesome.Erase" /></div>
                }
            </HeaderTemplate>
            <ChildContent>
                <AppButton Label="Members" Href="@MembersHref(context.Value.Id)" IconName="@FontAwesome.User"></AppButton>
                <AppButton Label="Modules" Href="@ModulesHref(context.Value.Id)" IconName="@FontAwesome.Modules"></AppButton>
                <AppButton Label="Stations" Href="@StationsHref(context.Value.Id)" IconName="@FontAwesome.Stations"></AppButton>
                <AppButton Label="Waybills" Href="@WaybillsHref(context.Value.Id)" IconName="@FontAwesome.Waybills"></AppButton>
                @if (context.MayEdit)
                {
                    <AppButton Label="Edit" Href="@EditHref(context.Value.Id)"></AppButton>
                    <AppButton Label="NewMeeting" Href="@CreateMeetingHref(context.Value.Id)" IconName="@FontAwesome.Meeting"></AppButton>
                }
                @if (DeletableIds.Contains(context.Value.Id))
                {
                    <AppButton Label="Delete" Href="@DeleteHref(context.Value.Id)" />
                }
            </ChildContent>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="PaginationState" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int CountryId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public int? SelectedCountryId { get; set; }
    [SupplyParameterFromQuery(Name = "short")] public string? ShortName { get; set; }
    [SupplyParameterFromQuery(Name = "full")] public string? FullName { get; set; }
    [SupplyParameterFromQuery(Name = "countryname")] public string? CountryName { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "direction")] public string? Direction { get; set; }
    [SupplyParameterFromQuery(Name = "delete")] public int? DeleteId { get; set; }
    [SupplyParameterFromForm(FormName = "delete")] public int DeleteGroupId { get; set; }

    ClaimsPrincipal? Principal;
    PaginationState PaginationState = new() { ItemsPerPage = 20 };
    IEnumerable<(Group Value, bool MayEdit)> Groups = [];
    IEnumerable<ListboxItem>? Countries;
    bool HasGroupsFromSeveralCountries;
    IReadOnlySet<int> DeletableIds = new HashSet<int>();

    GroupsFilter Filter => new() { ShortName = ShortName, FullName = FullName, CountryName = CountryName };

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Countries = await CountryService.ListboxItemsAsync(Principal);
    }

    protected async override Task OnParametersSetAsync()
    {
        if (CountryId < 1)
        {
            var id = SelectedCountryId > 0 ? SelectedCountryId.Value : Principal.CountryId();
            Navigator.NavigateTo($"Groups/Country/{id}");
            return;
        }
        Groups = [.. (await GroupService.GetAllAsync(Principal, CountryId)).Select(g => (g.Item1, g.Item2))];
        HasGroupsFromSeveralCountries = Groups.Select(g => g.Value.CountryId).Distinct().Count() > 1;
        DeletableIds = await GroupService.DeletableIdsAsync(Principal, Groups.Select(g => g.Value.Id));
    }

    async Task DeleteAsync()
    {
        // Only a group shown as deletable in this list is deleted; the service checks the conditions again.
        var deleted = DeletableIds.Contains(DeleteGroupId) && (await GroupService.DeleteAsync(Principal, DeleteGroupId)).Count > 0;
        HttpContext.SetFlashMessage(deleted ? "DeletedSuccessfully" : "DeleteFailed", deleted);
        Navigator.NavigateTo(WithoutDelete);
    }

    Group? GroupToDelete => DeleteId > 0 && DeletableIds.Contains(DeleteId.Value) ? Groups.FirstOrDefault(g => g.Value.Id == DeleteId).Value : null;
    string DeleteHref(int groupId) => Navigator.GetUriWithQueryParameter("delete", groupId);
    string WithoutDelete => Navigator.GetUriWithQueryParameter("delete", (string?)null);

    IQueryable<(Group Value, bool MayEdit)> FilteredGroups => Filter.Apply(Groups, CountryNameOf).AsQueryable();

    bool IsSelectCountryVisible => Countries is not null && Countries.Count() > 1;

    static string CountryNameOf(Group group) => group.Country.EnglishName.GetLocalizedString(null);
    string CityName(Group? group) => group is null ? string.Empty : group.CountryId == CountryId ? group.CityName : $"{group.CityName} ({group.Country.DomainSuffix.ToUpperInvariant()})";
    string GroupDomain(Group? group) => group?.GroupDomain is not null ? group.GroupDomain.Name : string.Empty;
    string ClearFilterHref => Sort.HasValue ? $"Groups/Country/{CountryId}?sort={Uri.EscapeDataString(Sort)}&direction={Uri.EscapeDataString(Direction ?? "")}" : $"Groups/Country/{CountryId}";
    string EditHref(int groupId) => $"groups/{groupId}/edit";
    string MembersHref(int groupId) => $"groups/{groupId}/members";
    string ModulesHref(int groupId) => $"groups/{groupId}/modules";
    string StationsHref(int groupId) => $"groups/{groupId}/stations";
    string CreateMeetingHref(int groupId) => $"/Meetings/Create/{groupId}";
    string WaybillsHref(int groupId) => $"reports/waybills/group/{groupId}";
}