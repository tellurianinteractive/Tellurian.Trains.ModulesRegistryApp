@page "/Groups/{id:int}/Modules"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.3): ModulesList, whose Clone is a POST form. *@

@inject IStringLocalizer<Strings> Localizer

@inject ModuleService ModuleService
@inject GroupService GroupService

<PageHeading ObjectName="Modules" Context="Owner" IconClass="@FontAwesome.Module"  PageAction="PageAction.List" BackHref="@BackHref" />

<ModulesList Modules="OwnedModules" Principal="Principal" MayEdit="MayEdit" OwningGroupId="Id" BackHref="@($"Groups/{Id}/Modules")" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [Parameter] public int Id { get; set; }

    ClaimsPrincipal? Principal;
    IEnumerable<Module>? OwnedModules;
    Group? Owner;
    // The groups list is static, so this page may have no history (Migration step 3.3).
    string BackHref => Owner is null ? "Groups/Index" : $"Groups/Country/{Owner.CountryId}";
    bool IsGroupDataAdministrator;

    protected async override Task OnParametersSetAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Owner = await GroupService.FindByIdAsync(Principal, Id);
        IsGroupDataAdministrator = await GroupService.IsGroupDataAdministratorAsync(Principal, Id, Owner?.CountryId);
        OwnedModules = await ModuleService.GetAllAsync(Principal, OwnerRef);
    }

    bool MayEdit => IsGroupDataAdministrator;
    ModuleOwnershipRef OwnerRef => ModuleOwnershipRef.Group(Id);
}