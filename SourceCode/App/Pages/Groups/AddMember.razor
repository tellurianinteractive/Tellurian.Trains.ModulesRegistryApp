@page "/Groups/{groupid:int}/Members/Add"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6): a POST of GroupMemberFormData, the person chosen with the person search (person-search.js
   writes the id to its hidden input, which is posted). The country to search in is a GET form (?country=), initially the group's.
   Only the group's member administrators get the form. After adding, a redirect to the members list; the result is a one-time
   message. *@

@using ModulesRegistry.Forms.Groups

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject GroupService GroupService
@inject CountryService CountryService
@inject PersonService PersonService

<PageHeading Label="AddMemberIn" Context="Group" IconClass="@FontAwesome.Group" PageAction="PageAction.List" HelpContext="AddGroupMember" ShowHelpInitially="true" BackHref="@MembersHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

@if (Group is not null && Form is not null)
{
    <ListboxForm Id="member-country" Action="@($"Groups/{GroupId}/Members/Add")" Name="country" Items="CountryItems" ItemType="Country" SelectedId="SearchCountryId" />
}

<EditTemplate Item="Form" FormName="add-member" OnValidSubmit="AddAsync">
    <Inputs>
        <AppSearchPerson @bind-Value="Form!.PersonId" Name="Form.PersonId" SelectedName="@SelectedPersonName"
                         SearchLabel="@Localizer.SearchObject("Person", MinimumSearchCharacters)"
                         MinimumSearchCharacters="MinimumSearchCharacters"
                         CountryId="SearchCountryId"
                         ExcludeGroupId="GroupId"
                         AddPersonHref="@($"persons/0/editgroup/{GroupId}")" />
        <AppInputFill Width="8" />
        <AppInputCheck Width="3" Label="IsGroupAdministrator" @bind-Value="Form!.IsGroupAdministrator" />
        <AppInputCheck Width="3" Label="IsDataAdministrator" @bind-Value="Form!.IsDataAdministrator" />
        <AppInputCheck Width="3" Label="IsMeetingAdministrator" @bind-Value="Form!.IsMeetingAdministrator" />
        <AppInputCheck Width="3" Label="MayBorrowGroupsModules" @bind-Value="Form!.MayBorrowGroupsModules" />
        <AppInputCheck Width="3" Label="MemberMayBorrowMyModules" @bind-Value="Form!.MemberMayBorrowMyModules" />
    </Inputs>
</EditTemplate>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int GroupId { get; set; }
    [SupplyParameterFromQuery(Name = "country")] private int? CountryId { get; set; }
    [SupplyParameterFromForm(FormName = "add-member")] private GroupMemberFormData? Form { get; set; }

    const int MinimumSearchCharacters = 3;
    ClaimsPrincipal? Principal;
    Group? Group;
    IEnumerable<ListboxItem>? CountryItems;
    string? SelectedPersonName;
    string? FailureMessage;

    int SearchCountryId => CountryId > 0 ? CountryId.Value : Group?.CountryId ?? 0;
    string MembersHref => $"Groups/{GroupId}/Members";

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Group = await GroupService.FindByIdAsync(Principal, GroupId);
        if (Group is null || !await GroupService.IsGroupMemberAdministratorAsync(Principal, Group.Id, Group.CountryId))
        {
            Group = null;
            Form = null; // Shows "no records"; also when a form was posted.
            return;
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= new GroupMemberFormData();
        if (Form.PersonId > 0) SelectedPersonName = (await PersonService.FindByIdAsync(Principal, Form.PersonId))?.Name();
        CountryItems = await CountryService.ListboxItemsAsync(Principal, allSupportedCountries: true);
    }

    async Task AddAsync()
    {
        if (Form is null || Group is null) return;
        var (count, message, _) = await GroupService.AddMemberAsync(Principal, Form.AsEntity(groupId: GroupId));
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        Navigator.NavigateTo(MembersHref);
    }
}