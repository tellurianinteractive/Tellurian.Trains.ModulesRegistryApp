@page "/Groups/{groupid:int}/Members"

@attribute [Authorize(Policy = "User")]
@* Static SSR (Migration step 3.6): a group's members. The group's member administrators get Add, Edit, Invite and Remove; Remove is
   a link that adds ?remove={id}, which shows a confirmation with a POST form, as Delete on the groups list. *@

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject GroupService GroupService

<PageHeading Label="MembersIn" Context="Group" IconClass="@FontAwesome.Group" PageAction="PageAction.List" BackHref="@BackHref" />

@if (Group is null)
{
    <ActionMessage Label="NoRecordsToDisplay" AlertType="warning" />
}
else
{
    <p>@Localizer["GroupMembersCount", Group.GroupMembers.Count]</p>
    @if (IsGroupAdministrator)
    {
        <AppButton Label="Add" Href="@($"Groups/{Group.Id}/Members/Add")" AlwaysShowLabel="true" />
        @if (Principal is not null)
        {
            <MailToButton Sender="Principal.Sender()" Recipients="@Group.GroupMembers.MailHolders()" Subject="@Group.Name()" />
        }
    }

    @if (MemberToRemove is not null)
    {
        <div class="alert alert-warning mt-2" role="alert">
            <form method="post" @formname="remove-member" @onsubmit="RemoveAsync" data-enhance>
                <AntiforgeryToken />
                <input type="hidden" name="RemoveMemberId" value="@MemberToRemove.Id" />
                <strong>@Localizer["Remove"] @MemberToRemove.Person.Name()?</strong>
                <AppButton Label="Remove" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
                <AppButton Label="Cancel" Href="@SelfHref" AlwaysShowLabel="true" />
            </form>
        </div>
    }

    <TableTemplate Items="Group.GroupMembers.OrderBy(gm => gm.Person.Name())">
        <TableHeader>
            <th>@Localizer["Name"]</th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["IsGroupAdministrator"]</span></th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["IsDataAdministrator"]</span></th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["IsMeetingAdministrator"]</span></th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["MayBorrowGroupsModules"]</span></th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["MemberMayBorrowMyModules"]</span></th>
            <th class="tilted" style="@TiltedStyle"><span>@Localizer["IsModulesExcluded"]</span></th>
            <th align="center">@Localizer["Status"]</th>
            <th>@Localizer["Actions"]</th>
        </TableHeader>
        <RowTemplate Context="member">
            <td>@member.Person.Name()</td>
            <td align="center">@member.IsGroupAdministrator.AsYesOrNo()</td>
            <td align="center">@member.IsDataAdministrator.AsYesOrNo()</td>
            <td align="center">@member.IsMeetingAdministrator.AsYesOrNo()</td>
            <td align="center">@member.MayBorrowGroupsModules.AsYesOrNo()</td>
            <td align="center">@member.MemberMayBorrowMyModules.AsYesOrNo()</td>
            <td align="center">@member.IsModulesExcluded.AsYesOrNo()</td>
            <td align="center"><PersonStatusIcon Person="member.Person" /></td>
            <td style="white-space: nowrap !important;">
                <AppButton Label="Modules" Href="@($"Persons/{member.PersonId}/Modules/InGroup/{member.GroupId}")" />
                <AppButton Label="Stations" Href="@($"Persons/{member.PersonId}/Stations/InGroup/{member.GroupId}")" />
                @if (IsGroupAdministrator)
                {
                    <AppButton Label="Edit" Href="@($"Groups/{member.GroupId}/Members/{member.Id}/Edit")" />
                    <AppButton Label="Remove" Href="@($"{SelfHref}?remove={member.Id}")" />
                    @if (member.Person.MayBeInvited())
                    {
                        <AppButton Label="Invite" Href="@($"Persons/{member.PersonId}/Invite")" />
                    }
                }
            </td>
        </RowTemplate>
    </TableTemplate>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int GroupId { get; set; }
    [SupplyParameterFromQuery(Name = "remove")] private int? RemoveId { get; set; }
    [SupplyParameterFromForm(FormName = "remove-member")] private int RemoveMemberId { get; set; }

    ClaimsPrincipal? Principal;
    Group? Group;
    bool IsGroupAdministrator;

    static readonly string[] TiltedLabels = ["IsGroupAdministrator", "IsDataAdministrator", "IsMeetingAdministrator", "MayBorrowGroupsModules", "MemberMayBorrowMyModules", "IsModulesExcluded"];
    // The tilted titles don't take space in the layout, so the header gets the height of the longest one in the current language.
    string TiltedStyle => FormattableString.Invariant($"height: {TiltedLabels.Max(l => Localizer[l].Value.Length) * 0.27 + 1.5:0.0}em");

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        Group = await GroupService.FindByIdAsync(Principal, GroupId);
        if (Group is not null) IsGroupAdministrator = await GroupService.IsGroupMemberAdministratorAsync(Principal, Group.Id, Group.CountryId);
    }

    GroupMember? MemberToRemove => IsGroupAdministrator && RemoveId > 0 ? Group?.GroupMembers.FirstOrDefault(gm => gm.Id == RemoveId) : null;

    string SelfHref => $"Groups/{GroupId}/Members";
    // The groups list is static, so this page may have no history (Migration step 3.3).
    string BackHref => Group is null ? "Groups/Index" : $"Groups/Country/{Group.CountryId}";

    async Task RemoveAsync()
    {
        if (Group is null || !IsGroupAdministrator) return;
        // Only a member of this group (the service checks the user's rights for the member's group).
        if (!Group.GroupMembers.Any(gm => gm.Id == RemoveMemberId)) return;
        var removed = (await GroupService.RemoveMemberAsync(Principal, RemoveMemberId)).Count > 0;
        HttpContext.SetFlashMessage(removed ? "DeletedSuccessfully" : "DeleteFailed", removed);
        Navigator.NavigateTo(SelfHref);
    }
}