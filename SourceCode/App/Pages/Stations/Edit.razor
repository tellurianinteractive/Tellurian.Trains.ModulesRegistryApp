@page "/Stations/{id:int}/Edit"
@page "/Stations/{id:int}/Edit/{ownerid:int}"
@page "/Stations/{id:int}/Edit/PersonOwned/{PersonId:int}"
@page "/Stations/{id:int}/Edit/PersonOwned/{PersonId:int}/InGroup/{GroupId:int}"
@page "/Stations/{id:int}/Edit/GroupOwned/{GroupId:int}"
@page "/Stations/Create/{moduleId:int}/PersonOwned/{PersonId:int}"
@page "/Stations/Create/{moduleId:int}/GroupOwned/{GroupId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6), as the freight customer form: a POST of StationFormData, validated in the browser and again
   on the server; the id comes from the address. A new station is added to a module of the owner in the address (person or group)
   that has no station; an existing station is edited by a user who may edit it (MayEditStationAsync), whatever owner the address
   names, and its module can't be changed: the field is disabled, so the stored module is set before validation. The tracks are
   listed below, each edited on its own form (TrackEdit.razor); Delete is ?deleteTrack={id} with a POST confirmation. The
   instructions document is uploaded with a static form (DocumentUploadForm). After saving, a redirect to this form, which reads
   the station back; the result is a one-time message. *@

@using ModulesRegistry.Forms.Stations

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject ModuleService ModuleService
@inject StationService StationService
@inject StationTrackService StationTrackService
@inject RegionService RegionService

<PageHeading ObjectName="OperationLocation" Context="@Existing" IconClass="@FontAwesome.Station" PageAction="@Id.ToAddOrEditPageAction()" HelpContext="Station" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

<EditTemplate Item="Form" FormName="station" OnValidSubmit="SaveAsync">
    <Inputs>
        <AppInputSelect Width="3" Label="Module" @bind-Value="Form!.ModuleId" Items="ModulesItems" ShowPleaseSelect="true" IsDisabled="@IsEdit" />
        <AppInputSelectNullable Width="2" Label="Region" @bind-Value="Form!.RegionId" Items="RegionItems" ShowNoneOption="true" />
        <AppInputText Width="3" Label="FullName" @bind-Value="Form!.FullName" />
        <AppInputText Width="1" Label="Signature" @bind-Value="Form!.Signature" />
        <AppInputFill Width="3" />
        <AppInputCheck Width="2" Label="HasCargoCustomers" @bind-Value="Form!.HasCargoCustomers" />
        <AppInputCheck Width="2" Label="IsJunction" @bind-Value="Form!.IsJunction" />
        <AppInputCheck Width="2" Label="IsTerminus" @bind-Value="Form!.IsTerminus" />
        <AppInputCheck Width="2" Label="IsShadowStation" @bind-Value="Form!.IsShadow" />
        <AppInputCheck Width="2" Label="IsHarbour" @bind-Value="Form!.IsHarbour" />
        <AppInputCheck Width="2" Label="IsKeyRequired" @bind-Value="Form!.IsKeyRequired" />
        <AppInputText Width="12" Label="OperatingInstructions,YouCanUseMarkdown" @bind-Value="Form!.OperationInstructionsMarkdown" NumberOfRows="10" />
    </Inputs>
</EditTemplate>

@if (Existing is not null && Form is not null)
{
    <h3 class="mt-3">@Localizer["Tracks"]</h3>
    @if (TrackToDelete is not null)
    {
        <div class="alert alert-warning mt-2" role="alert">
            <form method="post" @formname="delete-track" @onsubmit="DeleteTrackAsync" data-enhance>
                <AntiforgeryToken />
                <input type="hidden" name="DeleteTrackId" value="@TrackToDelete.Id" />
                <strong>@Localizer["Delete"] @Localizer["Track"].Value.ToLowerInvariant() @TrackToDelete.Designation?</strong>
                <AppButton Label="Delete" IsSubmit="true" IconName="@FontAwesome.Delete" AlwaysShowLabel="true" />
                <AppButton Label="Cancel" Href="@SelfHref" AlwaysShowLabel="true" />
            </form>
        </div>
    }
    <div class="col-12">
        <AppButton Label="Add" ObjectName="Track" Href="@TrackHref(0)" />
    </div>
    <TableTemplate Items="Existing.StationTracks.OrderBy(st => st.DisplayOrder)" RowStyle="RowStyle">
        <TableHeader>
            <th>@Localizer["TrackNumber"]</th>
            <th>@Localizer["Direction"]</th>
            <th>@Localizer["MaxTrainLength"]</th>
            <th>@Localizer["PlatformLength"]</th>
            <th>@Localizer["SpeedLimit"]</th>
            <th>@Localizer["Usage"]</th>
            <th>@Localizer["Actions"]</th>
        </TableHeader>
        <RowTemplate Context="track">
            <td>@track.Designation</td>
            <td>@track.DirectionText(EnumExtensions.StationTrackDirectionListboxItems())</td>
            <td>@track.MaxTrainLengthText()</td>
            <td>@track.PlatformLengthText()</td>
            <td>@track.SpeedLimitText()</td>
            <td>@track.UsageText()</td>
            <td style="white-space: nowrap !important;">
                <AppButton Label="Edit" Href="@TrackHref(track.Id)" />
                <AppButton Label="Delete" Href="@($"{SelfHref}?deleteTrack={track.Id}")" />
            </td>
        </RowTemplate>
    </TableTemplate>

    <DocumentsUpload DocumentedObject="Existing">
        <Uploads>
            <DocumentUploadForm FileExtension="pdf" DocumentedObject="Existing" Label="OperatingInstructions" MaxFileSizeKb="250" ReturnHref="@SelfHref" />
        </Uploads>
    </DocumentsUpload>
}

@code {
    // Reached from the static modules list, this page may have no history (Migration step 3.3).
    const string BackHref = "Modules/Index";
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public int GroupId { get; set; }
    [Parameter] public int PersonId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [SupplyParameterFromForm(FormName = "station")] private StationFormData? Form { get; set; }
    [SupplyParameterFromForm(FormName = "delete-track")] private int DeleteTrackId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteTrack")] private int? DeleteTrackQueryId { get; set; }

    ClaimsPrincipal? Principal;
    Station? Existing;
    IEnumerable<ListboxItem>? ModulesItems;
    IEnumerable<ListboxItem>? RegionItems;
    string? FailureMessage;

    bool IsEdit => Id > 0;

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        if (IsEdit)
        {
            Existing = await StationService.FindByIdAsync(Principal, Id);
            if (Existing is null || !await StationService.MayEditAsync(Principal, Existing.Id))
            {
                Existing = null;
                Form = null; // Shows "no records"; also when a form was posted.
                return;
            }
            var module = Existing.Modules.FirstOrDefault(m => m.Id == Existing.PrimaryModuleId);
            ModulesItems = module is null ? [] : [new ListboxItem(module.Id, module.FullName)];
        }
        else
        {
            ModulesItems = await ModuleService.ModuleItems(Principal, ModuleOwnershipRef.Any(Principal, PersonId, GroupId), stationId: 0); // Modules without a station.
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        if (Form is null)
        {
            Form = (Existing ?? new Station()).AsFormData();
            if (!IsEdit && ModuleId > 0 && ModulesItems.Any(m => m.Id == ModuleId))
            {
                Form.ModuleId = ModuleId;
                Form.FullName = (await ModuleService.FindByIdAsync(Principal, ModuleId))?.FullName ?? string.Empty; // A new station is named as its module.
            }
        }
        if (Existing is not null) Form.ModuleId = Existing.PrimaryModuleId ?? 0; // The disabled field isn't posted.
        RegionItems = await RegionService.ListboxItemsAsync(Principal, 0);
    }

    StationTrack? TrackToDelete => DeleteTrackQueryId > 0 ? Existing?.StationTracks.FirstOrDefault(t => t.Id == DeleteTrackQueryId) : null;

    string OwnerSuffix =>
        PersonId > 0 && GroupId > 0 ? $"/PersonOwned/{PersonId}/InGroup/{GroupId}" :
        PersonId > 0 ? $"/PersonOwned/{PersonId}" :
        GroupId > 0 ? $"/GroupOwned/{GroupId}" : string.Empty;

    string EditHref(int stationId) => $"Stations/{stationId}/Edit{OwnerSuffix}";
    string SelfHref => EditHref(Id);
    string TrackHref(int trackId) => $"Stations/{Id}/Tracks/{trackId}/Edit";

    async Task SaveAsync()
    {
        if (Form is null) return;
        // Edit: only the form's fields change on the loaded station (Migration section 3.4, the data-loss rule).
        var station = Form.AsEntity(Existing);
        var (count, message, saved) = await StationService.SaveAsync(Principal, station, Form.ModuleId);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo(EditHref((saved ?? station).Id));
    }

    async Task DeleteTrackAsync()
    {
        // Only a track of this station (the service also checks the user's rights for the track's station).
        if (Existing is null || !Existing.StationTracks.Any(t => t.Id == DeleteTrackId)) return;
        var deleted = (await StationTrackService.DeleteAsync(Principal, DeleteTrackId)).Count > 0;
        HttpContext.SetFlashMessage(deleted ? "DeletedSuccessfully" : "DeleteFailed", deleted);
        Navigator.NavigateTo(SelfHref);
    }

    string RowStyle(StationTrack track) => $"background-color: {track.BackgroundColor()}";
}