@page "/Persons/{id:int}/Edit"
@page "/Persons/{id:int}/Edit/{countryId:int}"
@page "/Persons/{id:int}/EditGroup/{groupId:int}"

@attribute [Authorize(Policy = "User")]
@* Static SSR form (Migration step 3.6): a POST of PersonFormData; the id, the country of a new person and the group come from the
   address. The form is shown to those who may edit the person (PersonService.MayEditAsync): global administrators, country
   administrators in the person's country, the person themselves, and those who administer the group's members, for a new person or a
   member of the group (who is then added to the group). Fields the user may not change are disabled, and the page sets their stored
   values before the posted form is validated, since a disabled field isn't posted; the service checks the same rules. Unlock is a
   POST form for administrators. After saving, a redirect to the form's own address. *@

@using ModulesRegistry.Forms.Persons

@inject NavigationManager Navigator
@inject PersonService PersonService
@inject UserService UserService
@inject CountryService CountryService
@inject GroupService GroupService
@inject IStringLocalizer<Strings> Localizer

<PageHeading ObjectName="Person" IconClass="@FontAwesome.User" PageAction="@Id.ToAddOrEditPageAction()" HelpContext="Person" BackHref="@BackHref" />

@if (FailureMessage is not null)
{
    <ActionMessage Label="@FailureMessage" AlertType="stop" />
}

@if (Existing?.User is not null)
{
    <UserStatusView User="Existing.User" />
}
<EditTemplate Item="Form" FormName="person" OnValidSubmit="SaveAsync" DeleteHref="@DeleteHref" MayDelete="MayDelete">
    <Inputs>
        <AppFormRow>
            <AppInputText Width="2" Label="FirstName" @bind-Value="Form!.FirstName" />
            <AppInputText Width="2" Label="NickName" @bind-Value="Form!.NickName" />
            <AppInputText Width="2" Label="MiddleName" @bind-Value="Form!.MiddleName" />
            <AppInputText Width="2" Label="LastName" @bind-Value="Form!.LastName" />
            <AppInputText Width="2" Label="CityName" @bind-Value="Form!.CityName" />
            <AppInputSelect Width="2" Label="Country" Items="CountryItems" ShowPleaseSelect="true" IsDisabled="@(!MaySelectCountry)" @bind-Value="Form!.CountryId" />
        </AppFormRow>
        <AppFormRow>
            <AppInputText Width="6" Label="EmailAddresses" @bind-Value="Form!.EmailAddresses" />
        </AppFormRow>
        <AppFormRow>
            <AppInputNumber Width="2" Label="FremoNumber" @bind-Value="Form!.FremoMemberNumber" />
            @if (Existing is not null && Existing.IsFremoMember())
            {
                <AppDisplay Width="2" Label="FremoMemberNumber" Value="@Existing.FremoNumber()" BackColor="#e9ecef" />
            }
            <AppInputText Width="2" Label="FremoPrefix" @bind-Value="Form!.FremoOwnerSignature" />
            <AppInputText Width="6" Label="FremoReservedAdresses" @bind-Value="Form!.FremoReservedAdresses" Placeholder="LocoAddressExample" />
        </AppFormRow>
        @if (ShowsUserRights)
        {
            <hr />
            <AppCheckGroup>
                <AppInputCheck Label="IsGlobalAdministrator" @bind-Value="Form!.IsGlobalAdministrator" IsDisabled="@(!Principal.MayChangeGlobalAdministrator(Existing!.User!))" />
                <AppInputCheck Label="IsCountryAdministrator" @bind-Value="Form!.IsCountryAdministrator" IsDisabled="@(!Principal.MayChangeCountryAdministrator)" />
                <AppInputCheck Label="IsApiAccessPermitted" @bind-Value="Form!.IsApiAccessPermitted" />
                <AppInputCheck Label="MayUploadSkpDrawing" @bind-Value="Form!.MayUploadSkpDrawing" />
                <AppInputCheck Label="MayVerifyWiFreds" @bind-Value="Form!.MayManageWiFreds" />
            </AppCheckGroup>
            <AppFormRow>
                <AppInputText Width="6" Label="AdministratorAreaOfResposibility" @bind-Value="Form!.AdministratorAreaOfResposibility" />
                <AppDisplay Width="3" Label="PasswordResetAttempts" Value="@Existing!.User!.PasswordResetAttempts.ToString()" BackColor="#e9ecef" />
                <AppDisplay Width="3" Label="FailedLoginAttempts" Value="@Existing.User.FailedLoginAttempts.ToString()" BackColor="#e9ecef" />
                @if (Existing.User.IsApiAccessPermitted)
                {
                    <AppDisplay Width="6" Label="ApiKey" Value="@Existing.User.ApiKey()" BackColor="#e9ecef" />
                }
            </AppFormRow>
        }
    </Inputs>
</EditTemplate>

@if (ShowsUserRights && Existing!.User!.IsLockedOut())
{
    <br />
    <h3>@Localizer["UserIsLockedOut"]</h3>
    <form method="post" @formname="unlock" @onsubmit="UnlockAsync" data-enhance>
        <AntiforgeryToken />
        <input type="hidden" name="Unlock" value="true" />
        <AppButton Label="Unlock" IsSubmit="true" />
    </form>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int CountryId { get; set; }
    [Parameter] public int GroupId { get; set; }
    [SupplyParameterFromForm(FormName = "person")] private PersonFormData? Form { get; set; }
    [SupplyParameterFromForm(FormName = "unlock")] private bool Unlock { get; set; }

    ClaimsPrincipal? Principal;
    Person? Existing;
    IEnumerable<ListboxItem>? CountryItems;
    string? FailureMessage;

    bool MaySelectCountry => Principal.IsGlobalAdministrator() || GroupId > 0;
    // The rights of a stored user, for global administrators and the country administrators of the person's country.
    bool ShowsUserRights => Existing?.User is not null && Principal.MayChangeUserRights(Existing.CountryId);
    bool MayDelete => Existing is not null && Principal.MayDeletePerson(Existing.CountryId);
    string? DeleteHref => Existing is null ? null : $"Persons/{Existing.Id}/Delete";

    protected override async Task OnInitializedAsync()
    {
        Principal = await AuthenticationStateTask.GetClaimsPrincipalAsync();
        if (Id > 0)
        {
            Existing = await PersonService.FindByIdAsync(Principal, Id);
        }
        var person = Existing ?? new Person { CountryId = DefaultCountryId };
        if ((Id > 0 && Existing is null) || !await PersonService.MayEditAsync(Principal, person, GroupId))
        {
            Existing = null;
            Form = null; // Shows "no records"; also when a form was posted.
            return;
        }
        // On a POST, Form holds the posted values, also when they are invalid and the form is shown again.
        Form ??= person.AsFormData();
        // Disabled fields aren't posted: their values are the stored ones.
        if (!MaySelectCountry) Form.CountryId = person.CountryId;
        if (Existing?.User is { } user)
        {
            if (!Principal.MayChangeGlobalAdministrator(user)) Form.IsGlobalAdministrator = user.IsGlobalAdministrator;
            if (!Principal.MayChangeCountryAdministrator) Form.IsCountryAdministrator = user.IsCountryAdministrator;
            if (!ShowsUserRights)
            {
                Form.IsApiAccessPermitted = user.IsApiAccessPermitted;
                Form.MayUploadSkpDrawing = user.MayUploadSkpDrawing;
                Form.MayManageWiFreds = user.MayManageWiFreds;
                Form.AdministratorAreaOfResposibility = user.AdministratorAreaOfResposibility;
            }
        }
        // Group member administrators may add members from any fully supported country.
        CountryItems = await CountryService.ListboxItemsAsync(Principal, allSupportedCountries: GroupId > 0);
    }

    // A country administrator adds persons in their own country, a global administrator in the country of the address.
    int DefaultCountryId => CountryId > 0 && Principal.IsGlobalAdministrator() ? CountryId : Principal.CountryId();

    // The persons list is static, so this page may have no history (Migration step 3.3).
    string BackHref => GroupId > 0 ? $"Groups/{GroupId}/Members" : $"Persons/Country/{Existing?.CountryId ?? DefaultCountryId}";
    string FormHref(int personId) => GroupId > 0 ? $"Persons/{personId}/EditGroup/{GroupId}" : $"Persons/{personId}/Edit";

    async Task SaveAsync()
    {
        if (Form is null) return;
        // Edit: only the form's fields change on the loaded person and its user (Migration section 3.4, the data-loss rule).
        var person = Form.AsEntity(Existing);
        var (count, message, saved) = await PersonService.SaveAsync(Principal, person, GroupId);
        if (count == 0)
        {
            FailureMessage = message;
            return;
        }
        var savedId = (saved ?? person).Id;
        if (GroupId > 0 && Existing is null)
        {
            await GroupService.AddMemberAsync(Principal, new GroupMember { GroupId = GroupId, PersonId = savedId });
        }
        if (count > 0) HttpContext.SetFlashMessage("Saved", FlashMessageLevel.Success);
        else HttpContext.SetFlashMessage("NoModification", FlashMessageLevel.Info);
        Navigator.NavigateTo(FormHref(savedId));
    }

    async Task UnlockAsync()
    {
        if (!Unlock || !ShowsUserRights || Principal.IsReadOnly()) return;
        await UserService.UnlockUser(Existing!.User);
        HttpContext.SetFlashMessage("Unlock", FlashMessageLevel.Success);
        Navigator.NavigateTo(FormHref(Existing.Id));
    }
}