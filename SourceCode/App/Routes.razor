@inject IStringLocalizer<App> Localizer

<CascadingValue Value="AntiforgeryToken" IsFixed="true">
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly" >
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="alert alert-danger">
                        <h2><span class="fa fa-times-circle"></span> @Localizer["YouAreNotAuthorizedToViewThisPage"]</h2>
                        <ContentView ContentName="ReasonsForNotAuthorised" />
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="alert alert-warning">
                    <h2><span class="fa fa-unlink"></span> @Localizer["SorryNothingToDisplayHere"]</h2>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
</CascadingValue>

@code {
    /// <summary>From <c>App</c>: the antiforgery token for forms posted to endpoints, such as the login form.</summary>
    [Parameter] public string? AntiforgeryFieldName { get; set; }
    [Parameter] public string? AntiforgeryRequestToken { get; set; }

    private AntiforgeryFormToken? AntiforgeryToken =>
        AntiforgeryFieldName is null || AntiforgeryRequestToken is null ? null : new(AntiforgeryFieldName, AntiforgeryRequestToken);
}
