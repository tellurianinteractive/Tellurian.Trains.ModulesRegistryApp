@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> Localizer
@using System.Web;
@using ModulesRegistry.Diagnostics

<NotificationArea />

<div class="page">
    <div class="sidebar">
        <div class="noprint">
            <NavMenu />
        </div>
    </div>
    <div class="main">
        <div class="noprint">
            <div class="top-row px-4 auth">
                <LoginControl />
                <a class="nav-link" href="TermsOfUse">
                    @Localizer["TermsOfUse"]
                </a>
                <a class="nav-link" href="Contact">
                    @Localizer["Contact"]
                </a>
                <a class="nav-link" href="About">
                    @Localizer["About"]
                </a>
            </div>
        </div>
        <div class="content px-4">
            <AppErrorBoundary @ref="ErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        <h2><span class="fa fa-exclamation-triangle"></span> @Localizer["UnexpectedErrorHeading"]</h2>
                        <p>@Localizer["UnexpectedErrorText"]</p>
                    </div>
                </ErrorContent>
            </AppErrorBoundary>
        </div>
    </div>
</div>

@code {
    private AppErrorBoundary? ErrorBoundary;

    // A new page (the layout gets a new Body) clears an error shown for the previous one.
    protected override void OnParametersSet() => ErrorBoundary?.Recover();
}
