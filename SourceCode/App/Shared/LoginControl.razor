@implements IDisposable

@inject IStringLocalizer<App> Localizer
@inject NavigationManager Navigator
@inject DefaultUser DefaultUserService

<AuthorizeView>
    <Authorized>
        <span class="languageselector"><LanguageSelector /></span>

        <b>@context.User.LoginStatus(Localizer)</b>
        <a class="ml-md-auto btn btn-primary"
           href="/logout?returnUrl=/"
           target="_top">@Localizer["Logout"]</a>
    </Authorized>
    <NotAuthorized>
        @* A plain form posted to the login endpoint (not handled by Blazor), so the credentials are never in a URL.
           display: contents keeps the inputs and the button laid out as direct children of the top row. *@
        <form method="post" action="@LoginEndpoint.Route.TrimStart('/')" style="display: contents">
            @if (AntiforgeryToken is not null)
            {
                <input type="hidden" name="@AntiforgeryToken.FieldName" value="@AntiforgeryToken.Value" />
            }
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="text" name="username" value="@DefaultUserService.Username" placeholder="@Localizer["Username"]" autocomplete="username" />
            &nbsp;&nbsp;
            <input type="password" name="password" value="@DefaultUserService.Password" placeholder="@Localizer["Password"]" autocomplete="current-password" />
            <button type="submit" class="ml-md-auto btn btn-primary" style="margin-left: 1.5rem; white-space: nowrap">@Localizer["Login"]</button>
        </form>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private AntiforgeryFormToken? AntiforgeryToken { get; set; }

    private string ReturnUrl => Navigator.ToBaseRelativePath(Navigator.Uri);

    // The return URL follows the page the user is on; the layout doesn't re-render this component on navigation.
    protected override void OnInitialized() => Navigator.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigator.LocationChanged -= OnLocationChanged;
}