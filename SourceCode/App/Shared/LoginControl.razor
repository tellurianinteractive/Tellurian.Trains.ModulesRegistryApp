@implements IDisposable

@inject IStringLocalizer<Strings> Localizer
@inject NavigationManager Navigator
@inject DefaultUser DefaultUserService

<AuthorizeView>
    <Authorized>
        @* Below 900 px, the user's name is in the menu (NavMenu); the icon's tooltip is always there. *@
        <LanguageSelector />
        <span class="wide-only" style="white-space: nowrap"><b>@context.User.LoginName()</b></span>
        <span class="@context.User.LoginIcon()" role="img" style="font-size: 1.25rem; cursor: help"
              title="@context.User.LoginTooltip(Localizer)" aria-label="@context.User.LoginTooltip(Localizer)"></span>
        <a class="btn btn-primary"
           href="/logout?returnUrl=/"
           target="_top">@Localizer["Logout"]</a>
    </Authorized>
    <NotAuthorized>
        @* A plain form posted to the login endpoint (not handled by Blazor), so the credentials are never in a URL. *@
        <form method="post" action="@LoginEndpoint.Route.TrimStart('/')" class="login-form">
            @if (AntiforgeryToken is not null)
            {
                <input type="hidden" name="@AntiforgeryToken.FieldName" value="@AntiforgeryToken.Value" />
            }
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="text" name="username" value="@DefaultUserService.Username" placeholder="@Localizer["Username"]" aria-label="@Localizer["Username"]" autocomplete="username" />
            <input type="password" name="password" value="@DefaultUserService.Password" placeholder="@Localizer["Password"]" aria-label="@Localizer["Password"]" autocomplete="current-password" />
            <button type="submit" class="btn btn-primary" style="white-space: nowrap">@Localizer["Login"]</button>
        </form>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private AntiforgeryFormToken? AntiforgeryToken { get; set; }

    private string ReturnUrl => Navigator.ToBaseRelativePath(Navigator.Uri);

    // The return URL follows the page the user is on; the layout doesn't re-render this component on navigation.
    protected override void OnInitialized() => Navigator.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigator.LocationChanged -= OnLocationChanged;
}