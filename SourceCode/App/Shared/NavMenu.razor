@inject IStringLocalizer<Strings> Localizer
@inject AppService AppService

@* The menu drops down from the top bar (MainLayout) at all widths. Its toggle is a checkbox with labels, so it works also
   in static SSR pages (Migration step 3.1): the toggler, and the backdrop that closes the menu on a click outside it.
   In interactive pages, a click in the menu also closes it (through the binding). *@
<input type="checkbox" id="nav-menu-state" class="nav-menu-state" @bind="expanded" />
<label for="nav-menu-state" class="nav-menu-backdrop" aria-hidden="true"></label>

<div class="app-bar-start navbar navbar-dark">
    <label for="nav-menu-state" class="navbar-toggler" title="@Localizer["Menu"]" aria-label="@Localizer["Menu"]">
        <span class="navbar-toggler-icon"></span>
    </label>
    <a class="navbar-brand" href="">
        @Localizer["AppName"] @AppService.AppVersion
        <span class="copyright">&copy; 2021-@DateTime.Now.Year Stefan Fjällemark @LanguageExtensions.GetLocalizedString("Sweden")</span>
    </a>
</div>

<nav class="nav-menu" @onclick="CloseNavMenu">
    <ul class="nav flex-column">
        <AuthorizeView>
            <li class="nav-item px-3 nav-menu-user narrow-only">
                <span class="@context.User.LoginIcon()" aria-hidden="true"></span>@context.User.LoginName()
            </li>
        </AuthorizeView>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="fa fa-home" aria-hidden="true" />@Localizer["Home"]
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="Content/articles-documentation">
                <span class="fa fa-info-circle" aria-hidden="true" />@Localizer["Documentation"]
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="ReleaseNotes">
                <span class="fa fa-info-circle" aria-hidden="true" />Release Notes
            </NavLink>
        </li>
        @* Below 900 px, from the top bar (MainLayout, LoginControl). *@
        <li class="nav-item px-3 narrow-only" style="border-top: solid 1px white">
            <NavLink class="nav-link" href="TermsOfUse">
                <span class="fa fa-file-contract" aria-hidden="true" />@Localizer["TermsOfUse"]
            </NavLink>
        </li>
        <li class="nav-item px-3 narrow-only">
            <NavLink class="nav-link" href="Contact">
                <span class="fa fa-envelope" aria-hidden="true" />@Localizer["Contact"]
            </NavLink>
        </li>
        <li class="nav-item px-3 narrow-only">
            <NavLink class="nav-link" href="About">
                <span class="fa fa-info" aria-hidden="true" />@Localizer["About"]
            </NavLink>
        </li>
        <li class="nav-item px-3" style="border-top: solid 1px white; border-bottom: solid 1px white">
            <NavLink class="nav-link" href="Meetings/Index">
                <span class="@FontAwesome.Meeting" aria-hidden="true" />@Localizer["Meetings"]
            </NavLink>
        </li>

        <AuthorizeView Policy="@AppPolicyNames.User">
            <li class="nav-item px-3" >
                <NavLink class="nav-link" href="Modules/My">
                    <span class="@FontAwesome.Module" aria-hidden="true" />@Localizer["MyModules"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="Stations/Index">
                    <span class="@FontAwesome.Stations" aria-hidden="true" />@Localizer["MyOperationLocations"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="Meetings/My">
                    <span class="@FontAwesome.Meeting" aria-hidden="true" />@Localizer["MyMeetings"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="Vehicles/My">
                    <span class="@FontAwesome.Vehicle" aria-hidden="true" />@Localizer["MyVehicles"]
                </NavLink>
            </li>
            <li class="nav-item px-3" style="border-bottom: solid 1px white">
                <NavLink class="nav-link" href="Throttles/1">
                    <span class="@FontAwesome.Wifi" aria-hidden="true" />@Localizer["MyThrottles"]
                </NavLink>
            </li>
        </AuthorizeView>
        <AuthorizeView Policy="@AppPolicyNames.Admin">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href=@PersonsHref>
                    <span class="@FontAwesome.People" aria-hidden="true" />@Localizer["Persons"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="vehicles">
                    <span class="@FontAwesome.Train" aria-hidden="true" />@Localizer["Vehicles"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="@FontAwesome.User" aria-hidden="true" />@Localizer["UsersMenu"]
                </NavLink>
            </li>
        </AuthorizeView>
        <AuthorizeView Policy="@AppPolicyNames.User">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href=@GroupsHref>
                    <span class="@FontAwesome.Group" aria-hidden="true" />@Localizer["Groups"]
                </NavLink>
            </li>
            <li class="nav-item px-3" style="border-bottom: solid 1px white">
                <NavLink class="nav-link" href="Modules/Index">
                    <span class="@FontAwesome.Modules" aria-hidden="true" />@Localizer["Modules"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="FreightCustomers">
                    <span class="@FontAwesome.Customer" aria-hidden="true" />@Localizer["FreightCustomers"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="ExternalStations">
                    <span class="@FontAwesome.Station" aria-hidden="true" />@Localizer["ExternalStations"]
                </NavLink>
            </li>
            <li class="nav-item px-3" style="border-bottom: solid 1px white">
                <NavLink class="nav-link" href=@RegionsHref>
                    <span class="fa fa-shield-alt" aria-hidden="true" />@Localizer["Regions"]
                </NavLink>
            </li>
        </AuthorizeView>
        <AuthorizeView Policy="@AppPolicyNames.Admin">
            <li class="nav-item px-3" style="border-bottom: solid 1px white">
                <NavLink class="nav-link" href="Throttles">
                    <span class="@FontAwesome.Wifi" aria-hidden="true" />@Localizer["Throttles"]
                </NavLink>
            </li>
        </AuthorizeView>
        <AuthorizeView Policy="@AppPolicyNames.User">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="ModuleStandards">
                    <span class="@FontAwesome.Standard" aria-hidden="true" />@Localizer["ModuleStandards"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="ModuleStandards/EndProfiles">
                    <span class="@FontAwesome.Standard" aria-hidden="true" />@Localizer["ModuleEndProfiles"]
                </NavLink>
            </li>
            <li class="nav-item px-3" style="border-bottom: solid 1px white">
                <NavLink class="nav-link" href="Cargo/Index">
                    <span class="@FontAwesome.Cargo" aria-hidden="true" />@Localizer["CargoTypes"]
                </NavLink>
            </li>
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="Tools">
                    <span class="@FontAwesome.Tools" aria-hidden="true" />@Localizer["Tools"]
                </NavLink>
            </li>
        </AuthorizeView>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="Users/Settings">
                <span class="@FontAwesome.User" aria-hidden="true" />@Localizer["UserSettings"]
            </NavLink>
        </li>
        <li class="nav-item px-3" style="border-bottom: solid 1px white">
            <NavLink class="nav-link" href="Country/Statistics">
                <span class="fa fa-flag" aria-hidden="true" />@Localizer["Statistics"]
            </NavLink>
        </li>
        <div style="color: white" class="nav-item px-3">@Localizer["ExternalLinks"]:</div>
        <li class="nav-item px-3">
            <a class="nav-link" href="https://wagoncardapp.azurewebsites.net/" target="_blank">
                <span class="fa fa-train" aria-hidden="true" />@Localizer["LokAndWagonCards"]
            </a>
        </li>
        <li class="nav-item px-3">
            <a class="nav-link" href="@FastclockHref" target="_blank">
                <span class="fa fa-clock" aria-hidden="true" />@Localizer["FastClock"]
            </a>
        </li>
        <li class="nav-item px-3" style="border-bottom: solid 1px white">
            <a class="nav-link" href="https://github.com/tellurianinteractive/Tellurian.Trains.ModulesRegistryApp/" target="_blank">
                <span style="padding-right:4px"class="fab fa-github" aria-hidden="true" /> GitHub
            </a>
        </li>
    </ul>
</nav>

@code {

    private bool expanded;
    private void CloseNavMenu() => expanded = false;

    [CascadingParameter] private Task<AuthenticationState>? authenticationStateTask { get; set; }
    ClaimsPrincipal? Principal;


    protected override async Task OnInitializedAsync()
    {
        Principal = await authenticationStateTask.GetClaimsPrincipalAsync();
    }

    private string FastclockHref =>
        Principal is not null && Principal.GivenName().HasValue() ? $"https://fastclock.azurewebsites.net/user/{System.Web.HttpUtility.UrlEncode(Principal.GivenName())}" :
        "https://fastclock.azurewebsites.net/";

    string PersonsHref => $"Persons/Country/{AppService.LastCountryId}";
    string RegionsHref => $"Regions/Country/{AppService.LastCountryId}";
    string GroupsHref => $"Groups/Country/{AppService.LastCountryId}";

}
