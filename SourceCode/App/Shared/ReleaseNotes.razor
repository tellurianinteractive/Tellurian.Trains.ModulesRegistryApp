@page "/ReleaseNotes"
@attribute [ExcludeFromInteractiveRouting]

@* Static SSR (Migration step 3.2). The release notes are fetched from GitHub, so the page is cached for a while. *@
<CacheView ExpiresAfter="TimeSpan.FromMinutes(30)">
    <MarkdownView Href="https://raw.githubusercontent.com/tellurianinteractive/Tellurian.Trains.ModulesRegistryApp/master/RELEASENOTES.md" />
</CacheView>