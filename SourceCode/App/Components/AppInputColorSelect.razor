@using System.Diagnostics.CodeAnalysis

@inherits AppInputBase<string>
@inject IStringLocalizer<Strings> Localizer

@* A choice among named colours as round swatches (since 1.15.22 without visible names): radio buttons whose labels are circles
   in the colour; the name is the tooltip and is read by screen readers. Coloured in every browser (the options of a native
   drop-down aren't, in Safari) and usable with the keyboard; works without JavaScript in static SSR forms (name attribute, field
   message) and in interactive ones. The value is the hex code. *@

<div class="@WidthCss">
    <fieldset class="color-swatches" disabled="@IsDisabled">
        @if (Label.HasValue)
        {
            <legend class="form-control-label">@LabelText(Localizer)</legend>
        }
        <div class="color-swatch-list">
            @foreach (var color in Colors ?? [])
            {
                var id = $"{Label}-{color.Name}";
                <input type="radio" class="color-swatch-input" id="@id" name="@NameAttributeValue" value="@color.HexColor" checked="@IsSelected(color)" @onchange="() => Select(color)" />
                <label class="color-swatch" for="@id" style="background-color: @color.HexColor" title="@Localizer[color.Name]"><span class="visually-hidden">@Localizer[color.Name]</span></label>
            }
        </div>
    </fieldset>
    @if (ValidationFor is not null)
    {
        <div class="form-control-validation">
            <ValidationMessage For="@ValidationFor" />
        </div>
    }
    else if (ShowFieldValidationMessage)
    {
        <ValidationMessage For="@ValueExpression" />
    }
</div>

@code {
    [Parameter] public IEnumerable<NamedColor>? Colors { get; set; }

    bool IsSelected(NamedColor color) => color.HexColor.EqualsCaseInsensitive(CurrentValue);

    void Select(NamedColor color) => CurrentValueAsString = color.HexColor;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}