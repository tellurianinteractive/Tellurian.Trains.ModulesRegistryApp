@inject IStringLocalizer<Strings> Localizer

@* Copies the recipients' email addresses, as an AppButton: the text to copy is in data-copy-text, handled by a click listener in
   App.razor (every page is static SSR since Migration step 3.7). *@
<AppButton Label="@(Label ?? "CopyAllMailAddresses")" IconName="@FontAwesome.Mail" AdditionalAttributes="CopyAttributes" />

@code {
    [Parameter] public required IEnumerable<MailHolder> Recipients { get; set; }
    [Parameter] public string? Label { get; set; } = "CopyAllMailAddresses";

    Dictionary<string, object> CopyAttributes => new()
    {
        ["data-copy-text"] = string.Join(';', Recipients.Select(r => r.EmailAddresses)),
        ["data-copied"] = Localizer["Copied"].Value,
    };
}