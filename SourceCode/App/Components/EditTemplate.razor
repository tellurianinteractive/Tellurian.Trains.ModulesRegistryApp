@inject IStringLocalizer<Strings> Localizer

@typeparam TItem

@if (Item is null)
{
    <ActionMessage Label="NoRecordsToDisplay" AlertType="warning" />
}
else
{
    @* With a FormName, the form is a static SSR form (Migration step 3.4): a POST with antiforgery, validated with DataAnnotations
       on a form model, in the browser and again on the server; each input shows its own message. *@
    @* A static form also asks before leaving it with unsaved changes (leave-guard.js): the texts of its dialog are attributes, and a
       form shown again after a POST (an invalid or failed save; a successful one redirects) is unsaved from the start. *@
    <EditForm Model="Item" OnValidSubmit="OnValidSubmit" FormName="@FormName" Enhance="@IsStatic" @attributes="FormAttributes">
        @* Validated with the form model's DataAnnotations (FluentValidation removed with the last interactive form, Migration step 3.6). *@
        <DataAnnotationsValidator />
        @if (!IsStatic)
        {
            <ValidationSummary />
        }
        @Inputs
        <div class="col-12">
            @if (ShowSaveButton)
            {
                <AppButton Label="Save" IsSubmit="true" />
            }
            @Buttons
            @if (MayDelete && DeleteHref.HasValue)
            {
                <AppButton Label="Delete" IsSubmit="false" Href="@DeleteHref" />
            }
            @InputsBelowButtons
        </div>
        <hr/>
        @SubInputs
        
    </EditForm>
}

@code {
    [Parameter] public TItem? Item { get; set; }
    [Parameter] public RenderFragment? Inputs { get; set; }
    [Parameter] public RenderFragment? Buttons { get; set; }
    [Parameter] public RenderFragment? InputsBelowButtons { get; set; }
    [Parameter] public RenderFragment? SubInputs { get; set; }
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public bool ShowSaveButton { get; set; } = true;
    [Parameter] public string? DeleteHref { get; set; }
    [Parameter] public bool MayDelete { get; set; }
    /// <summary>The form's name on a static SSR page, matching the page's <c>[SupplyParameterFromForm(FormName = ...)]</c>.</summary>
    [Parameter] public string? FormName { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    bool IsStatic => FormName.HasValue;

    // The form's class, and on a static form the leave guard's texts (EditForm takes other attributes only as a splat).
    Dictionary<string, object> FormAttributes => !IsStatic ? new() { ["class"] = "row g-3" } : new()
    {
        ["class"] = "row g-3",
        ["data-leave-guard"] = Localizer["StayOnPageWithUnsavedChanges"].Value,
        ["data-leave-yes"] = Localizer["Yes"].Value,
        ["data-leave-no"] = Localizer["No"].Value,
        ["data-leave-unsaved"] = HttpMethods.IsPost(HttpContext?.Request.Method ?? "") ? "true" : "false",
    };
}