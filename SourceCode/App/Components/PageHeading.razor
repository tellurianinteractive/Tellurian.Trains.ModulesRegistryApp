@inject IStringLocalizer<Strings> Localizer

@* A page's heading with its help and back icons, for static SSR (Migration step 3.3; every page since step 3.7). The help toggle is
   a checkbox with a label, as the menu toggle, and CSS shows the help when it is checked. There is no page history on the server, so
   the back arrow is shown only when the page says where back is. *@
<div>
    @if (IsHelpAvailable)
    {
        <input type="checkbox" id="page-help-state" class="page-help-state" checked="@ShowHelpInitially" />
    }
    <div class="flex-container">
        <div style="flex-grow: 4">
            <span class="@IconClass" /><span>@Localizer.HeadingText(Label, ObjectName, Context, PageAction)</span>
        </div>
        <div class="noprint" style="flex-grow: 1; text-align:right">
            @* A one-time message (FlashMessage) is moved here by wwwroot/js/flash-message.js, beside the icons, where it is seen. *@
            <span class="flash-message-slot"></span>
            @if (IsHelpAvailable)
            {
                <label for="page-help-state" class="fa fa-question-circle page-help-toggle" title="@Localizer["Help"]" aria-label="@Localizer["Help"]"></label>
            }
            @if (BackHref.HasValue)
            {
                <a href="@BackHref" class="fa fa-arrow-alt-circle-left page-back" title="@Localizer["Back"]" aria-label="@Localizer["Back"]"></a>
            }
        </div>
    </div>
    @if (HelpContentName is not null)
    {
        <div class="page-help">
            <ContentView ContentName="@HelpContentName" BackgroundColour="#ffffcc" />
        </div>
    }
    <hr />
</div>
@code {
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? ObjectName { get; set; }
    [Parameter] public object? Context { get; set; }
    [Parameter] public PageAction PageAction { get; set; }
    [Parameter] public string? HelpContext { get; set; }
    [Parameter] public bool ShowHelpInitially { get; set; }
    /// <summary>Where the back arrow goes; without it, the page has no back arrow.</summary>
    [Parameter] public string? BackHref { get; set; }

    bool IsHelpAvailable => HelpContext.HasValue;
    string? HelpContentName => string.IsNullOrWhiteSpace(HelpContext) ? null : $"Help/{HelpContext}";
}