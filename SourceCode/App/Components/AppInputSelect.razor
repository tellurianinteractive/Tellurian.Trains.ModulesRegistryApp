@using System.Diagnostics.CodeAnalysis;
@using System.Globalization;

@inherits AppInputBase<int>
@inject IStringLocalizer<Strings> Localizer

<span class="@BootstrapWrapperCss">
    <span class="noprint">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label class="form-control-label" for="@Label">@LabelText(Localizer)</label>
        }
        @* With Typeahead, wwwroot/js/select-typeahead.js shows a search field instead of the list (the list is still posted);
           without JavaScript, the list works as usual. *@
        <select disabled=@IsDisabled style="@Style" class="form-select @CssClass" id="@Label" name="@NameAttributeValue" @bind="CurrentValueAsString"
                data-typeahead="@(Typeahead ? "" : null)" data-typeahead-placeholder="@(Typeahead && TypeaheadPlaceholder.HasValue ? Localizer[TypeaheadPlaceholder!].Value : null)"
                data-typeahead-not-found="@(Typeahead ? Localizer["NotFound"].Value : null)">
            @if (ShowPleaseSelect)
            {
                <option value="0" selected="@(CurrentValue == 0)">@PleaseSelectText</option>
            }
            @if (Items is not null)
            {
                foreach (var item in Items)
                {
                    <option selected="@Selected(item)" value="@item.Id" data-code="@(Typeahead ? item.SearchCode : null)" data-name="@(Typeahead ? item.SearchName : null)">@item.Description</option>
                }
            }
        </select>
        @if (ValidationFor is not null)
        {
            <div class="form-control-validation">
                <ValidationMessage For="@ValidationFor" />
            </div>
        }
        else if (ShowFieldValidationMessage)
        {
            <ValidationMessage For="@ValueExpression" />
        }
    </span>
</span>

@code {
    [Parameter] public IEnumerable<ListboxItem>? Items { get; set; }
    [Parameter] public bool ShowPleaseSelect { get; set; }
    [Parameter] public Action<int, object?>? OnSelected { get; set; }
    [Parameter] public int ItemHeight { get; set; }
    [Parameter] public object? Context { get; set; }
    /// <summary>Shows a search field that filters the options as you type: the start of an option's SearchCode, or anywhere in its name.</summary>
    [Parameter] public bool Typeahead { get; set; }
    /// <summary>The text key of the search field's placeholder.</summary>
    [Parameter] public string? TypeaheadPlaceholder { get; set; }

    string PleaseSelectText => string.IsNullOrWhiteSpace(Label) ? Localizer["Select"].Value : $"{Localizer["Select"]} {LabelText(Localizer).ToLowerInvariant()}";
    string BootstrapWrapperCss => Width.HasValue ? $"col-md-{Width}" : "col-md-4";

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out int result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedValue))
        {
            result = parsedValue;
            validationErrorMessage = null;
            OnSelected?.Invoke(result, Context);
            return true;

        }
        else
        {
            result = 0;
            validationErrorMessage = Localizer["NotANumber"].Value;
            return false;
        }
    }

    string? Selected(ListboxItem item) => item.Id == CurrentValue ? "selected" : null;
    string? Style => ItemHeight > 0 ? $"height: {ItemHeight}px; white-space: pre-wrap;" : null;
}