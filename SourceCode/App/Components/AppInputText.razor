@using System.Diagnostics.CodeAnalysis;

@inherits AppInputBase<string>
@inject IStringLocalizer<Strings> Localizer

<div class="@WidthCss">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-control-label" for="@Label">@LabelText(Localizer)</label>
    }
    @if (IsTextArea)
    {
        <textarea style="color: @TextColor; background-color: @BackColor" disabled="@IsDisabled" class="form-control @CssClass" id="@Label" name="@NameAttributeValue" @bind="@CurrentValue" rows="@NumberOfRows"/>
    }      
    else if (Type == "password")
    {
        @* A static page never writes a typed password back into the page, also when the form is shown again after a POST. *@
        <input disabled="@IsDisabled" type="password" class="form-control @CssClass" id="@Label" name="@NameAttributeValue" autocomplete="new-password" />
    }
    else
    {
        <input style="color: @TextColor; background-color: @BackColor" disabled="@IsDisabled" type="@Type" class="form-control @CssClass" id="@Label" name="@NameAttributeValue" @bind="@CurrentValue" placeholder="@PlaceholderText"
               list="@(Suggestions is null ? null : SuggestionsId)" autocomplete="@(Suggestions is null ? null : "off")" data-suggestions="@(Suggestions is null ? null : SuggestionsId)"
               data-enabled-by="@EnabledBy" />
        @* With Suggestions, the browser suggests the matching values while typing (a combo box); any other value may still be entered.
           With SuggestionsFilteredBy (names of other fields in the form), suggestion-filter.js shows only the suggestions that match
           those fields; without JavaScript, all are shown. With EnabledBy (names of checkboxes in the form), enabled-by.js enables
           the field only while one of them is checked; IsDisabled sets the state the page is rendered with. *@
        @if (Suggestions is not null)
        {
            <datalist id="@SuggestionsId" data-filter-by="@SuggestionsFilteredBy">
                @foreach (var suggestion in SuggestionsFilteredBy is null ? Suggestions.DistinctBy(s => s.Value, StringComparer.OrdinalIgnoreCase) : Suggestions)
                {
                    <option value="@suggestion.Value" data-filter="@(SuggestionsFilteredBy is null ? null : string.Join('|', suggestion.FilterValues))"></option>
                }
            </datalist>
        }
    }
    @if (ValidationFor is not null)
    {
        <div class="form-control-validation">
            <ValidationMessage For="@ValidationFor" />
        </div>
    }
    else if (ShowFieldValidationMessage)
    {
        <ValidationMessage For="@ValueExpression" />
    }
</div>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? InputType { get; set; }
    [Parameter] public string? TextColor { get; set; }
    [Parameter] public string? BackColor { get; set; }
    [Parameter] public int NumberOfRows { get; set; }
    [Parameter] public IEnumerable<TextSuggestion>? Suggestions { get; set; }
    [Parameter] public string? SuggestionsFilteredBy { get; set; }
    [Parameter] public string? EnabledBy { get; set; }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }

    string Type => string.IsNullOrWhiteSpace(InputType) ? "text" : InputType.ToLowerInvariant();
    string PlaceholderText => string.IsNullOrWhiteSpace(Placeholder) ? string.Empty : Localizer[Placeholder].Value;
    string Disabled => IsDisabled ? "disabled" : string.Empty;
    bool IsTextArea => NumberOfRows > 1;
    string SuggestionsId => $"{Label}-suggestions";
}