@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Localization

@inject IStringLocalizer<Strings> Localizer
@inject IAntiforgery Antiforgery
@inject IHostEnvironment Environment

@* The HTML document, rendered per request on the server (it replaced _Host.cshtml in Migration step 2.2).
   Pages run interactively over SignalR (InteractiveServer, without prerendering, as the old render-mode="Server"), except
   pages marked [ExcludeFromInteractiveRouting], which are rendered as static SSR, layout included (Migration step 3.1).
   The interactive router loads such a page with a full page load. *@

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["AppName"]</title>
    <base href="/" />
    @* Fingerprinted URLs from MapStaticAssets: a new deploy gives new URLs, so browsers never keep stale files (issue #233). *@
    <link href="@Assets["css/bootstrap/bootstrap.min.css"]" rel="stylesheet" />
    <link href="@Assets["css/fontawesome/css/all.css"]" rel="stylesheet">
    <link href="@Assets["css/site.css"]" rel="stylesheet" />
    <link href="@Assets["ModulesRegistry.styles.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode"AntiforgeryFieldName="@AntiforgeryFieldName" AntiforgeryRequestToken="@AntiforgeryRequestToken" />
    <div id="blazor-error-ui">
        @if (Environment.IsDevelopment())
        {
            <text>An unhandled exception has occurred. See browser dev tools for details.</text>
        }
        else
        {
            <text>An error has occurred. This application may no longer respond until reloaded.</text>
        }
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/person-search.js"]"></script>
    <script src="@Assets["js/filter-form.js"]"></script>
    <script src="@Assets["js/flash-message.js"]"></script>
    <script src="@Assets["js/form-validation.js"]"></script>
    <script src="@Assets["js/busy-form.js"]"></script>
    <script src="@Assets["js/leave-guard.js"]"></script>
    <script>
        window.clipboardCopy = {
            copyText: function (text, message) {
                navigator.clipboard.writeText(text).then(function () {
                    alert(message);
                })
                    .catch(function (error) {
                        alert(error);
                    });
            }
        };
    </script>
</body>
</html>

@code {
    private static readonly IComponentRenderMode InteractiveRenderMode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    /// <summary>Interactive, unless the requested page is marked <c>[ExcludeFromInteractiveRouting]</c>: then static SSR.</summary>
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveRenderMode : null;

    private string? AntiforgeryFieldName;
    private string? AntiforgeryRequestToken;

    protected override void OnInitialized()
    {
        // The culture chosen by request localization is stored in the culture cookie, as _Host.cshtml did.
        HttpContext.Response.Cookies.Append(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(new RequestCulture(CultureInfo.CurrentCulture, CultureInfo.CurrentUICulture)));

        // The token for forms posted from interactive components to endpoints, such as the login form.
        var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
        AntiforgeryFieldName = tokens.FormFieldName;
        AntiforgeryRequestToken = tokens.RequestToken;
    }
}