// Exceptions in the last 24 hours, one row per problem, with the count in the 7 days before and one sample.
let app = AppExceptions | where _ResourceId endswith "/components/moduleregistry";
let baseline = app
    | where TimeGenerated between (ago(8d) .. ago(24h))
    | summarize Previous7Days = count() by ProblemId;
app
| where TimeGenerated > ago(24h)
| summarize Last24Hours = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), MaxSeverity = max(SeverityLevel),
    Sample = take_any(bag_pack(
        "ExceptionType", ExceptionType, "OuterType", OuterType, "OuterMessage", OuterMessage,
        "InnermostType", InnermostType, "InnermostMessage", InnermostMessage, "Method", Method,
        "Properties", Properties, "Details", substring(tostring(Details), 0, 6000)))
    by ProblemId
| join kind=leftouter baseline on ProblemId
| project-away ProblemId1
| extend Previous7Days = coalesce(Previous7Days, 0)
| order by MaxSeverity desc, Last24Hours desc
| take 30