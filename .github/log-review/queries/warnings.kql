// Log entries at Warning or above (severity 2 = Warning, 3 = Error, 4 = Critical) in the last 24 hours,
// per category, event id and severity, with the count in the 7 days before and one sample message.
let app = AppTraces | where _ResourceId endswith "/components/moduleregistry" and SeverityLevel >= 2
    | extend Category = tostring(Properties.CategoryName), EventId = tostring(Properties.EventId);
let baseline = app
    | where TimeGenerated between (ago(8d) .. ago(24h))
    | summarize Previous7Days = count() by Category, EventId, SeverityLevel;
app
| where TimeGenerated > ago(24h)
| summarize Last24Hours = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
    SampleMessage = take_any(substring(Message, 0, 2000)) by Category, EventId, SeverityLevel
| join kind=leftouter baseline on Category, EventId, SeverityLevel
| project-away Category1, EventId1, SeverityLevel1
| extend Previous7Days = coalesce(Previous7Days, 0)
| order by SeverityLevel desc, Last24Hours desc
| take 50